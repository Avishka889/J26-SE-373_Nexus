{
  "$defs": {
    "AffectedComponent": {
      "additionalProperties": false,
      "description": "An architectural component an update reaches, and how that is known.",
      "properties": {
        "files": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Files",
          "type": "array"
        },
        "kind": {
          "anyOf": [
            {
              "enum": [
                "actor",
                "entity",
                "service",
                "constraint"
              ],
              "type": "string"
            },
            {
              "const": "module",
              "type": "string"
            }
          ],
          "title": "Kind"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "links": {
          "items": {
            "$ref": "#/$defs/ComponentLink"
          },
          "minItems": 1,
          "title": "Links",
          "type": "array"
        },
        "nodeId": {
          "minLength": 1,
          "title": "Nodeid",
          "type": "string"
        },
        "traces": {
          "items": {
            "pattern": "^R-\\d+$",
            "type": "string"
          },
          "title": "Traces",
          "type": "array"
        },
        "updateIds": {
          "items": {
            "pattern": "^u-[0-9a-f]{12}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Updateids",
          "type": "array"
        }
      },
      "required": [
        "nodeId",
        "label",
        "kind",
        "updateIds",
        "files",
        "links",
        "traces"
      ],
      "title": "AffectedComponent",
      "type": "object"
    },
    "AffectedFile": {
      "additionalProperties": false,
      "description": "A file that uses something an update changed.",
      "properties": {
        "implements": {
          "items": {
            "type": "string"
          },
          "title": "Implements",
          "type": "array"
        },
        "manifestStage": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Manifeststage"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "referenceCount": {
          "minimum": 1,
          "title": "Referencecount",
          "type": "integer"
        },
        "updateIds": {
          "items": {
            "pattern": "^u-[0-9a-f]{12}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Updateids",
          "type": "array"
        }
      },
      "required": [
        "path",
        "updateIds",
        "referenceCount",
        "manifestStage",
        "implements"
      ],
      "title": "AffectedFile",
      "type": "object"
    },
    "ChangedSymbol": {
      "additionalProperties": false,
      "description": "One symbol an update changes, and who said so.",
      "properties": {
        "detail": {
          "default": "",
          "title": "Detail",
          "type": "string"
        },
        "kind": {
          "enum": [
            "removed",
            "signature-changed",
            "renamed",
            "breaking-behaviour",
            "behaviour-changed",
            "deprecated",
            "added",
            "touched"
          ],
          "title": "Kind",
          "type": "string"
        },
        "source": {
          "enum": [
            "api-diff",
            "changelog"
          ],
          "title": "Source",
          "type": "string"
        },
        "symbol": {
          "minLength": 1,
          "title": "Symbol",
          "type": "string"
        },
        "tool": {
          "minLength": 1,
          "title": "Tool",
          "type": "string"
        },
        "updateId": {
          "pattern": "^u-[0-9a-f]{12}$",
          "title": "Updateid",
          "type": "string"
        }
      },
      "required": [
        "updateId",
        "symbol",
        "kind",
        "source",
        "tool",
        "detail"
      ],
      "title": "ChangedSymbol",
      "type": "object"
    },
    "ComponentLink": {
      "additionalProperties": false,
      "description": "One recorded reason a file belongs to a component.",
      "properties": {
        "detail": {
          "minLength": 1,
          "title": "Detail",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "via": {
          "enum": [
            "manifest-entity",
            "endpoint-entity",
            "build-module"
          ],
          "title": "Via",
          "type": "string"
        }
      },
      "required": [
        "via",
        "path",
        "detail"
      ],
      "title": "ComponentLink",
      "type": "object"
    },
    "EvidenceSpan": {
      "additionalProperties": false,
      "description": "Where in the repository the finding is, precisely enough to check.\n\nA span rather than a line, because a taint finding is a flow and a reader\nasked to confirm one line of it is being asked to trust the rest.",
      "properties": {
        "endLine": {
          "minimum": 1,
          "title": "Endline",
          "type": "integer"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "snippet": {
          "default": "",
          "title": "Snippet",
          "type": "string"
        },
        "startLine": {
          "minimum": 1,
          "title": "Startline",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "startLine",
        "endLine",
        "snippet"
      ],
      "title": "EvidenceSpan",
      "type": "object"
    },
    "ExtractionRecord": {
      "additionalProperties": false,
      "description": "The one index this run built, so a reader can see it was built once.",
      "properties": {
        "extractionId": {
          "minLength": 1,
          "title": "Extractionid",
          "type": "string"
        },
        "filesIndexed": {
          "minimum": 0,
          "title": "Filesindexed",
          "type": "integer"
        },
        "grammars": {
          "items": {
            "type": "string"
          },
          "title": "Grammars",
          "type": "array"
        },
        "parser": {
          "minLength": 1,
          "title": "Parser",
          "type": "string"
        },
        "seconds": {
          "minimum": 0,
          "title": "Seconds",
          "type": "number"
        }
      },
      "required": [
        "extractionId",
        "parser",
        "grammars",
        "filesIndexed",
        "seconds"
      ],
      "title": "ExtractionRecord",
      "type": "object"
    },
    "RefusedReference": {
      "additionalProperties": false,
      "description": "A reference that did not survive being re-read.",
      "properties": {
        "detail": {
          "default": "",
          "title": "Detail",
          "type": "string"
        },
        "line": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "reason": {
          "enum": [
            "file-not-found",
            "span-out-of-range",
            "snippet-does-not-match"
          ],
          "title": "Reason",
          "type": "string"
        },
        "updateId": {
          "pattern": "^u-[0-9a-f]{12}$",
          "title": "Updateid",
          "type": "string"
        }
      },
      "required": [
        "updateId",
        "path",
        "line",
        "reason",
        "detail"
      ],
      "title": "RefusedReference",
      "type": "object"
    },
    "SignalVote": {
      "additionalProperties": false,
      "description": "One signal's answer for one update, or its reason for having none.",
      "properties": {
        "abstainedReason": {
          "default": "",
          "title": "Abstainedreason",
          "type": "string"
        },
        "evidenceIds": {
          "items": {
            "type": "string"
          },
          "title": "Evidenceids",
          "type": "array"
        },
        "level": {
          "anyOf": [
            {
              "enum": [
                "low",
                "medium",
                "high"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Level"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "ruleId": {
          "minLength": 1,
          "title": "Ruleid",
          "type": "string"
        },
        "signal": {
          "enum": [
            "semver",
            "changelog",
            "usage"
          ],
          "title": "Signal",
          "type": "string"
        }
      },
      "required": [
        "signal",
        "level",
        "abstainedReason",
        "ruleId",
        "rationale",
        "evidenceIds"
      ],
      "title": "SignalVote",
      "type": "object"
    },
    "UnmappedFile": {
      "additionalProperties": false,
      "description": "An affected file no component could honestly be named for.",
      "properties": {
        "detail": {
          "default": "",
          "title": "Detail",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "reason": {
          "enum": [
            "not-in-manifest",
            "implements-nothing-mapped",
            "no-graph-node-matches",
            "graph-unavailable",
            "no-build-module"
          ],
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "path",
        "reason",
        "detail"
      ],
      "title": "UnmappedFile",
      "type": "object"
    },
    "UpdateImpact": {
      "additionalProperties": false,
      "description": "Signal three for one update.",
      "properties": {
        "apiDiff": {
          "enum": [
            "ran",
            "unavailable",
            "failed"
          ],
          "title": "Apidiff",
          "type": "string"
        },
        "apiDiffReason": {
          "default": "",
          "title": "Apidiffreason",
          "type": "string"
        },
        "importsPackage": {
          "title": "Importspackage",
          "type": "boolean"
        },
        "references": {
          "items": {
            "$ref": "#/$defs/UsageReference"
          },
          "title": "References",
          "type": "array"
        },
        "seconds": {
          "default": 0.0,
          "minimum": 0,
          "title": "Seconds",
          "type": "number"
        },
        "unreferenced": {
          "items": {
            "type": "string"
          },
          "title": "Unreferenced",
          "type": "array"
        },
        "updateId": {
          "pattern": "^u-[0-9a-f]{12}$",
          "title": "Updateid",
          "type": "string"
        },
        "usedByScripts": {
          "default": false,
          "title": "Usedbyscripts",
          "type": "boolean"
        },
        "vote": {
          "$ref": "#/$defs/SignalVote"
        }
      },
      "required": [
        "updateId",
        "importsPackage",
        "usedByScripts",
        "references",
        "unreferenced",
        "apiDiff",
        "apiDiffReason",
        "vote",
        "seconds"
      ],
      "title": "UpdateImpact",
      "type": "object"
    },
    "UsageReference": {
      "additionalProperties": false,
      "description": "One place the project uses a changed symbol, checked against the file.",
      "properties": {
        "match": {
          "enum": [
            "import",
            "member",
            "identifier"
          ],
          "title": "Match",
          "type": "string"
        },
        "span": {
          "$ref": "#/$defs/EvidenceSpan"
        },
        "symbol": {
          "minLength": 1,
          "title": "Symbol",
          "type": "string"
        },
        "symbolKind": {
          "enum": [
            "removed",
            "signature-changed",
            "renamed",
            "breaking-behaviour",
            "behaviour-changed",
            "deprecated",
            "added",
            "touched"
          ],
          "title": "Symbolkind",
          "type": "string"
        }
      },
      "required": [
        "symbol",
        "symbolKind",
        "match",
        "span"
      ],
      "title": "UsageReference",
      "type": "object"
    }
  },
  "$id": "https://sdlc.local/contracts/impact-report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The `impact-report` artefact.",
  "properties": {
    "affectedComponents": {
      "items": {
        "$ref": "#/$defs/AffectedComponent"
      },
      "title": "Affectedcomponents",
      "type": "array"
    },
    "affectedFiles": {
      "items": {
        "$ref": "#/$defs/AffectedFile"
      },
      "title": "Affectedfiles",
      "type": "array"
    },
    "changedSymbols": {
      "items": {
        "$ref": "#/$defs/ChangedSymbol"
      },
      "title": "Changedsymbols",
      "type": "array"
    },
    "codeVersion": {
      "minimum": 1,
      "title": "Codeversion",
      "type": "integer"
    },
    "designVersion": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Designversion"
    },
    "extraction": {
      "$ref": "#/$defs/ExtractionRecord"
    },
    "generatedAt": {
      "title": "Generatedat",
      "type": "string"
    },
    "granularity": {
      "default": "graph-node",
      "enum": [
        "graph-node",
        "module"
      ],
      "title": "Granularity",
      "type": "string"
    },
    "perUpdate": {
      "items": {
        "$ref": "#/$defs/UpdateImpact"
      },
      "title": "Perupdate",
      "type": "array"
    },
    "refusedCount": {
      "readOnly": true,
      "title": "Refusedcount",
      "type": "integer"
    },
    "refusedReferences": {
      "items": {
        "$ref": "#/$defs/RefusedReference"
      },
      "title": "Refusedreferences",
      "type": "array"
    },
    "unmappedFiles": {
      "items": {
        "$ref": "#/$defs/UnmappedFile"
      },
      "title": "Unmappedfiles",
      "type": "array"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "version",
    "generatedAt",
    "codeVersion",
    "designVersion",
    "granularity",
    "extraction",
    "changedSymbols",
    "perUpdate",
    "affectedFiles",
    "affectedComponents",
    "unmappedFiles",
    "refusedReferences",
    "refusedCount"
  ],
  "title": "ImpactReport",
  "type": "object"
}
