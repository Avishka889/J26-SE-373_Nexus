{
  "$defs": {
    "BuildReport": {
      "additionalProperties": false,
      "properties": {
        "isolation": {
          "minLength": 1,
          "title": "Isolation",
          "type": "string"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/BuildStepReport"
          },
          "minItems": 1,
          "title": "Steps",
          "type": "array"
        },
        "toolchain": {
          "minLength": 1,
          "title": "Toolchain",
          "type": "string"
        }
      },
      "required": [
        "toolchain",
        "isolation",
        "steps"
      ],
      "title": "BuildReport",
      "type": "object"
    },
    "BuildStepReport": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "minLength": 1,
          "title": "Command",
          "type": "string"
        },
        "durationSeconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Durationseconds"
        },
        "logTail": {
          "default": "",
          "title": "Logtail",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "passed",
            "failed",
            "not-run",
            "timed-out"
          ],
          "title": "Outcome",
          "type": "string"
        }
      },
      "required": [
        "name",
        "command",
        "outcome",
        "durationSeconds",
        "logTail"
      ],
      "title": "BuildStepReport",
      "type": "object"
    },
    "ManifestRow": {
      "additionalProperties": false,
      "properties": {
        "arm": {
          "default": "rule",
          "enum": [
            "rule",
            "llm",
            "merged"
          ],
          "title": "Arm",
          "type": "string"
        },
        "carriedFixes": {
          "items": {
            "minimum": 1,
            "type": "integer"
          },
          "title": "Carriedfixes",
          "type": "array"
        },
        "generator": {
          "enum": [
            "static",
            "rule",
            "model"
          ],
          "title": "Generator",
          "type": "string"
        },
        "implements": {
          "items": {
            "type": "string"
          },
          "title": "Implements",
          "type": "array"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "reusedFromVersion": {
          "default": 0,
          "minimum": 0,
          "title": "Reusedfromversion",
          "type": "integer"
        },
        "stage": {
          "minLength": 1,
          "title": "Stage",
          "type": "string"
        },
        "summary": {
          "default": "",
          "title": "Summary",
          "type": "string"
        },
        "writtenFrom": {
          "default": "",
          "title": "Writtenfrom",
          "type": "string"
        }
      },
      "required": [
        "path",
        "stage",
        "generator",
        "arm",
        "implements",
        "summary",
        "writtenFrom",
        "reusedFromVersion",
        "carriedFixes"
      ],
      "title": "ManifestRow",
      "type": "object"
    },
    "RepositoryPointer": {
      "additionalProperties": false,
      "properties": {
        "branch": {
          "default": "",
          "title": "Branch",
          "type": "string"
        },
        "commitSha": {
          "minLength": 1,
          "title": "Commitsha",
          "type": "string"
        },
        "defaultBranch": {
          "minLength": 1,
          "title": "Defaultbranch",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "owner": {
          "minLength": 1,
          "title": "Owner",
          "type": "string"
        },
        "provider": {
          "const": "github",
          "default": "github",
          "title": "Provider",
          "type": "string"
        },
        "pullRequestNumber": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pullrequestnumber"
        },
        "pullRequestUrl": {
          "default": "",
          "title": "Pullrequesturl",
          "type": "string"
        },
        "url": {
          "minLength": 1,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "owner",
        "name",
        "defaultBranch",
        "commitSha",
        "url",
        "branch",
        "pullRequestUrl",
        "pullRequestNumber"
      ],
      "title": "RepositoryPointer",
      "type": "object"
    }
  },
  "$id": "https://sdlc.local/contracts/code-repository.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "build": {
      "anyOf": [
        {
          "$ref": "#/$defs/BuildReport"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "manifest": {
      "items": {
        "$ref": "#/$defs/ManifestRow"
      },
      "title": "Manifest",
      "type": "array"
    },
    "notPushedReason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notpushedreason"
    },
    "repository": {
      "anyOf": [
        {
          "$ref": "#/$defs/RepositoryPointer"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "version",
    "manifest",
    "build",
    "repository",
    "notPushedReason"
  ],
  "title": "CodeRepository",
  "type": "object"
}
