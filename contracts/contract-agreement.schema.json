{
  "$defs": {
    "AgreementCounts": {
      "additionalProperties": false,
      "properties": {
        "agreementRate": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Agreementrate",
          "type": "number"
        },
        "endpointsCalled": {
          "minimum": 0,
          "title": "Endpointscalled",
          "type": "integer"
        },
        "endpointsImplemented": {
          "minimum": 0,
          "title": "Endpointsimplemented",
          "type": "integer"
        },
        "endpointsMissing": {
          "items": {
            "type": "string"
          },
          "title": "Endpointsmissing",
          "type": "array"
        },
        "endpointsTotal": {
          "minimum": 0,
          "title": "Endpointstotal",
          "type": "integer"
        },
        "endpointsUnused": {
          "items": {
            "type": "string"
          },
          "title": "Endpointsunused",
          "type": "array"
        },
        "foreignCalls": {
          "items": {
            "type": "string"
          },
          "title": "Foreigncalls",
          "type": "array"
        },
        "orphanRoutes": {
          "items": {
            "type": "string"
          },
          "title": "Orphanroutes",
          "type": "array"
        },
        "schemaMismatches": {
          "default": 0,
          "minimum": 0,
          "title": "Schemamismatches",
          "type": "integer"
        }
      },
      "required": [
        "endpointsTotal",
        "endpointsImplemented",
        "endpointsMissing",
        "endpointsCalled",
        "endpointsUnused",
        "orphanRoutes",
        "foreignCalls",
        "schemaMismatches",
        "agreementRate"
      ],
      "title": "AgreementCounts",
      "type": "object"
    },
    "AgreementFinding": {
      "additionalProperties": false,
      "properties": {
        "hint": {
          "default": "",
          "title": "Hint",
          "type": "string"
        },
        "location": {
          "anyOf": [
            {
              "$ref": "#/$defs/CodeLocation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "ruleId": {
          "minLength": 1,
          "title": "Ruleid",
          "type": "string"
        },
        "severity": {
          "enum": [
            "error",
            "warning"
          ],
          "title": "Severity",
          "type": "string"
        },
        "subject": {
          "default": "",
          "title": "Subject",
          "type": "string"
        }
      },
      "required": [
        "ruleId",
        "severity",
        "reason",
        "hint",
        "subject",
        "location"
      ],
      "title": "AgreementFinding",
      "type": "object"
    },
    "CodeLocation": {
      "additionalProperties": false,
      "properties": {
        "line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "path",
        "line"
      ],
      "title": "CodeLocation",
      "type": "object"
    }
  },
  "$id": "https://sdlc.local/contracts/contract-agreement.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contractVersion": {
      "minimum": 1,
      "title": "Contractversion",
      "type": "integer"
    },
    "counts": {
      "$ref": "#/$defs/AgreementCounts"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/AgreementFinding"
      },
      "title": "Findings",
      "type": "array"
    }
  },
  "required": [
    "contractVersion",
    "findings",
    "counts"
  ],
  "title": "ContractAgreement",
  "type": "object"
}
