{
  "$defs": {
    "BuildStepReport": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "minLength": 1,
          "title": "Command",
          "type": "string"
        },
        "durationSeconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Durationseconds"
        },
        "logTail": {
          "default": "",
          "title": "Logtail",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "passed",
            "failed",
            "not-run",
            "timed-out"
          ],
          "title": "Outcome",
          "type": "string"
        }
      },
      "required": [
        "name",
        "command",
        "outcome",
        "durationSeconds",
        "logTail"
      ],
      "title": "BuildStepReport",
      "type": "object"
    },
    "ExcludedUpdate": {
      "additionalProperties": false,
      "description": "An update left out of the candidate, and why.",
      "properties": {
        "detail": {
          "minLength": 1,
          "title": "Detail",
          "type": "string"
        },
        "reason": {
          "enum": [
            "rejected",
            "deferred",
            "no-restore-target",
            "superseded",
            "out-of-scope"
          ],
          "title": "Reason",
          "type": "string"
        },
        "updateId": {
          "pattern": "^u-[0-9a-f]{12}$",
          "title": "Updateid",
          "type": "string"
        }
      },
      "required": [
        "updateId",
        "reason",
        "detail"
      ],
      "title": "ExcludedUpdate",
      "type": "object"
    },
    "SmokeCheck": {
      "additionalProperties": false,
      "description": "One request against the booted candidate.",
      "properties": {
        "detail": {
          "default": "",
          "title": "Detail",
          "type": "string"
        },
        "method": {
          "const": "GET",
          "default": "GET",
          "title": "Method",
          "type": "string"
        },
        "ok": {
          "title": "Ok",
          "type": "boolean"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "statusCode": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Statuscode"
        }
      },
      "required": [
        "method",
        "path",
        "statusCode",
        "ok",
        "detail"
      ],
      "title": "SmokeCheck",
      "type": "object"
    }
  },
  "$id": "https://sdlc.local/contracts/release-candidate.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The `release-candidate` artefact.",
  "properties": {
    "candidateHash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Candidatehash",
      "type": "string"
    },
    "codeVersion": {
      "minimum": 1,
      "title": "Codeversion",
      "type": "integer"
    },
    "excluded": {
      "items": {
        "$ref": "#/$defs/ExcludedUpdate"
      },
      "title": "Excluded",
      "type": "array"
    },
    "fingerprint": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fingerprint"
    },
    "generatedAt": {
      "title": "Generatedat",
      "type": "string"
    },
    "image": {
      "default": "",
      "title": "Image",
      "type": "string"
    },
    "imageDigest": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Imagedigest"
    },
    "included": {
      "items": {
        "pattern": "^u-[0-9a-f]{12}$",
        "type": "string"
      },
      "title": "Included",
      "type": "array"
    },
    "isolation": {
      "minLength": 1,
      "title": "Isolation",
      "type": "string"
    },
    "lockfileSha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lockfilesha256"
    },
    "smoke": {
      "items": {
        "$ref": "#/$defs/SmokeCheck"
      },
      "title": "Smoke",
      "type": "array"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/BuildStepReport"
      },
      "minItems": 1,
      "title": "Steps",
      "type": "array"
    },
    "toolchain": {
      "minLength": 1,
      "title": "Toolchain",
      "type": "string"
    },
    "verified": {
      "readOnly": true,
      "title": "Verified",
      "type": "boolean"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "version",
    "generatedAt",
    "codeVersion",
    "candidateHash",
    "lockfileSha256",
    "included",
    "excluded",
    "image",
    "imageDigest",
    "toolchain",
    "isolation",
    "steps",
    "smoke",
    "fingerprint",
    "verified"
  ],
  "title": "ReleaseCandidate",
  "type": "object"
}
