    "ApiContract": {
      "additionalProperties": false,
      "description": "The effective contract one arm produced, or the human's merge.",
      "properties": {
        "endpoints": {
          "items": {
            "$ref": "#/$defs/ApiEndpoint"
          },
          "title": "Endpoints",
          "type": "array"
        },
        "entities": {
          "items": {
            "$ref": "#/$defs/EntityModel"
          },
          "title": "Entities",
          "type": "array"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "version",
        "entities",
        "endpoints"
      ],
      "title": "ApiContract",
      "type": "object"
    },
    "ApiContractArtefact": {
      "additionalProperties": false,
      "description": "The stored artefact: both arms, the comparison, and the choice.\n\n`contract` is the effective one downstream stages generate from. It equals\nthe chosen arm's output, or the recorded merge. The losing arm is kept\nwhole, because the evaluation compares arms and an artefact that kept only\nthe winner would have destroyed its own denominator.",
      "properties": {
        "chosen": {
          "default": "rule",
          "enum": [
            "rule",
            "llm",
            "merged"
          ],
          "title": "Chosen",
          "type": "string"
        },
        "comparison": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArmComparison"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "contract": {
          "$ref": "#/$defs/ApiContract"
        },
        "llmArm": {
          "anyOf": [
            {
              "$ref": "#/$defs/ApiContract"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "llmFailure": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Llmfailure"
        },
        "ruleArm": {
          "$ref": "#/$defs/ApiContract"
        },
        "ruleFindings": {
          "items": {
            "$ref": "#/$defs/ContractRuleFinding"
          },
          "title": "Rulefindings",
          "type": "array"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "version",
        "ruleArm",
        "llmArm",
        "llmFailure",
        "chosen",
        "contract",
        "comparison",
        "ruleFindings"
      ],
      "title": "ApiContractArtefact",
      "type": "object"
    },
    "ApiEndpoint": {
      "additionalProperties": false,
      "properties": {
        "authActors": {
          "items": {
            "type": "string"
          },
          "title": "Authactors",
          "type": "array"
        },
        "confidence": {
          "default": 0,
          "maximum": 98,
          "minimum": 0,
          "title": "Confidence",
          "type": "integer"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "method": {
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE"
          ],
          "title": "Method",
          "type": "string"
        },
        "origin": {
          "default": "rule",
          "enum": [
            "rule",
            "llm",
            "merged"
          ],
          "title": "Origin",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "pattern": "^/",
          "title": "Path",
          "type": "string"
        },
        "request": {
          "anyOf": [
            {
              "$ref": "#/$defs/EndpointSchema"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "response": {
          "anyOf": [
            {
              "$ref": "#/$defs/EndpointSchema"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "summary": {
          "default": "",
          "title": "Summary",
          "type": "string"
        },
        "traces": {
          "$ref": "#/$defs/EndpointTraces"
        },
        "validation": {
          "items": {
            "type": "string"
          },
          "title": "Validation",
          "type": "array"
        }
      },
      "required": [
        "id",
        "method",
        "path",
        "summary",
        "authActors",
        "request",
        "response",
        "validation",
        "traces",
        "origin",
        "confidence"
      ],
      "title": "ApiEndpoint",
      "type": "object"
    },
    "ArmComparison": {
      "additionalProperties": false,
