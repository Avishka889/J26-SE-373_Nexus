          "type": "integer"
        },
        "removed": {
          "items": {
            "type": "string"
          },
          "title": "Removed",
          "type": "array"
        },
        "toVersion": {
          "minimum": 1,
          "title": "Toversion",
          "type": "integer"
        }
      },
      "required": [
        "fromVersion",
        "toVersion",
        "added",
        "removed",
        "changed"
      ],
      "title": "ContractDiff",
      "type": "object"
    },
