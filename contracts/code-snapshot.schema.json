    "ContractConflict": {
      "additionalProperties": false,
      "description": "The same endpoint, said differently by the two arms. Surfaced as a\nfinding and decided item by item when the human picks merged.",
      "properties": {
        "endpointKey": {
          "description": "Canonical \"METHOD /path\".",
          "minLength": 1,
          "title": "Endpointkey",
          "type": "string"
        },
        "field": {
          "minLength": 1,
          "title": "Field",
          "type": "string"
        },
        "llmValue": {
          "default": "",
          "title": "Llmvalue",
          "type": "string"
        },
        "ruleValue": {
          "default": "",
          "title": "Rulevalue",
          "type": "string"
        }
      },
      "required": [
        "endpointKey",
        "field",
        "ruleValue",
        "llmValue"
      ],
      "title": "ContractConflict",
      "type": "object"
    },
    "ContractDiff": {
      "additionalProperties": false,
      "description": "What moved between two contract versions: the agile mechanic's receipt.",
      "properties": {
        "added": {
          "description": "Endpoint ids new in `to`.",
          "items": {
            "type": "string"
          },
          "title": "Added",
          "type": "array"
        },
        "changed": {
          "items": {
            "$ref": "#/$defs/EndpointChange"
          },
          "title": "Changed",
          "type": "array"
