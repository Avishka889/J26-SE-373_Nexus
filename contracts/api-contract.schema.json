{
  "$defs": {
    "ApiContract": {
      "additionalProperties": false,
      "description": "The effective contract one arm produced, or the human's merge.",
      "properties": {
        "endpoints": {
          "items": {
            "$ref": "#/$defs/ApiEndpoint"
          },
          "title": "Endpoints",
          "type": "array"
        },
        "entities": {
          "items": {
            "$ref": "#/$defs/EntityModel"
          },
          "title": "Entities",
          "type": "array"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "version",
        "entities",
        "endpoints"
      ],
      "title": "ApiContract",
      "type": "object"
    },
    "ApiEndpoint": {
      "additionalProperties": false,
      "properties": {
        "authActors": {
          "items": {
            "type": "string"
          },
          "title": "Authactors",
          "type": "array"
        },
        "confidence": {
          "default": 0,
          "maximum": 98,
          "minimum": 0,
          "title": "Confidence",
          "type": "integer"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "method": {
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE"
          ],
          "title": "Method",
          "type": "string"
        },
        "origin": {
          "default": "rule",
          "enum": [
            "rule",
            "llm",
            "merged"
          ],
          "title": "Origin",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "pattern": "^/",
          "title": "Path",
          "type": "string"
        },
        "request": {
          "anyOf": [
            {
              "$ref": "#/$defs/EndpointSchema"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "response": {
          "anyOf": [
            {
              "$ref": "#/$defs/EndpointSchema"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "summary": {
          "default": "",
          "title": "Summary",
          "type": "string"
        },
        "traces": {
          "$ref": "#/$defs/EndpointTraces"
        },
        "validation": {
          "items": {
            "type": "string"
          },
          "title": "Validation",
          "type": "array"
        }
      },
      "required": [
        "id",
        "method",
        "path",
        "summary",
        "authActors",
        "request",
        "response",
        "validation",
        "traces",
        "origin",
        "confidence"
      ],
      "title": "ApiEndpoint",
      "type": "object"
    },
    "ArmComparison": {
      "additionalProperties": false,
      "description": "The ablation data, one run's worth.",
      "properties": {
        "agreed": {
          "description": "Canonical keys both arms produced.",
          "items": {
            "type": "string"
          },
          "title": "Agreed",
          "type": "array"
        },
        "agreementRate": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Agreementrate",
          "type": "number"
        },
        "conflicts": {
          "items": {
            "$ref": "#/$defs/ContractConflict"
          },
          "title": "Conflicts",
          "type": "array"
        },
        "llm": {
          "$ref": "#/$defs/ArmCounts"
        },
        "llmOnly": {
          "items": {
            "type": "string"
          },
          "title": "Llmonly",
          "type": "array"
        },
        "rule": {
          "$ref": "#/$defs/ArmCounts"
        },
        "ruleOnly": {
          "items": {
            "type": "string"
          },
          "title": "Ruleonly",
          "type": "array"
        }
      },
      "required": [
        "rule",
        "llm",
        "agreed",
        "ruleOnly",
        "llmOnly",
        "conflicts",
        "agreementRate"
      ],
      "title": "ArmComparison",
      "type": "object"
    },
    "ArmCounts": {
      "additionalProperties": false,
      "properties": {
        "attempts": {
          "default": 0,
          "minimum": 0,
          "title": "Attempts",
          "type": "integer"
        },
        "endpoints": {
          "default": 0,
          "minimum": 0,
          "title": "Endpoints",
          "type": "integer"
        },
        "errors": {
          "default": 0,
          "minimum": 0,
          "title": "Errors",
          "type": "integer"
        },
        "warnings": {
          "default": 0,
          "minimum": 0,
          "title": "Warnings",
          "type": "integer"
        }
      },
      "required": [
        "endpoints",
        "errors",
        "warnings",
        "attempts"
      ],
      "title": "ArmCounts",
      "type": "object"
    },
    "ContractConflict": {
      "additionalProperties": false,
      "description": "The same endpoint, said differently by the two arms. Surfaced as a\nfinding and decided item by item when the human picks merged.",
      "properties": {
        "endpointKey": {
          "description": "Canonical \"METHOD /path\".",
          "minLength": 1,
          "title": "Endpointkey",
          "type": "string"
        },
        "field": {
          "minLength": 1,
          "title": "Field",
          "type": "string"
        },
        "llmValue": {
          "default": "",
          "title": "Llmvalue",
          "type": "string"
        },
        "ruleValue": {
          "default": "",
          "title": "Rulevalue",
          "type": "string"
        }
      },
      "required": [
        "endpointKey",
        "field",
        "ruleValue",
        "llmValue"
      ],
      "title": "ContractConflict",
      "type": "object"
    },
    "ContractRuleFinding": {
      "additionalProperties": false,
      "description": "One of the rule catalogue's findings about an arm's contract.",
      "properties": {
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "ruleId": {
          "minLength": 1,
          "title": "Ruleid",
          "type": "string"
        },
        "severity": {
          "enum": [
            "error",
            "warning"
          ],
          "title": "Severity",
          "type": "string"
        },
        "subject": {
          "default": "",
          "title": "Subject",
          "type": "string"
        }
      },
      "required": [
        "ruleId",
        "severity",
        "reason",
        "subject"
      ],
      "title": "ContractRuleFinding",
      "type": "object"
    },
    "EndpointSchema": {
      "additionalProperties": false,
      "description": "A request or response body, as fields plus the entity it derives from.",
      "properties": {
        "entity": {
          "default": "",
          "title": "Entity",
          "type": "string"
        },
        "fields": {
          "items": {
            "$ref": "#/$defs/SchemaField"
          },
          "title": "Fields",
          "type": "array"
        }
      },
      "required": [
        "entity",
        "fields"
      ],
      "title": "EndpointSchema",
      "type": "object"
    },
    "EndpointTraces": {
      "additionalProperties": false,
      "description": "Where an endpoint comes from. The unit of inference is the user action\non a screen, so screens and actions lead; stories and requirements ground\nthem in the plan and the brief.",
      "properties": {
        "actionIds": {
          "items": {
            "type": "string"
          },
          "title": "Actionids",
          "type": "array"
        },
        "requirementIds": {
          "items": {
            "pattern": "^R-\\d+$",
            "type": "string"
          },
          "title": "Requirementids",
          "type": "array"
        },
        "screenIds": {
          "items": {
            "type": "string"
          },
          "title": "Screenids",
          "type": "array"
        },
        "storyIds": {
          "items": {
            "pattern": "^US-\\d+$",
            "type": "string"
          },
          "title": "Storyids",
          "type": "array"
        }
      },
      "required": [
        "screenIds",
        "actionIds",
        "storyIds",
        "requirementIds"
      ],
      "title": "EndpointTraces",
      "type": "object"
    },
    "EntityModel": {
      "additionalProperties": false,
      "description": "A data shape the schemas reference, derived from a graph entity.",
      "properties": {
        "fields": {
          "items": {
            "$ref": "#/$defs/SchemaField"
          },
          "title": "Fields",
          "type": "array"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "traces": {
          "items": {
            "pattern": "^R-\\d+$",
            "type": "string"
          },
          "title": "Traces",
          "type": "array"
        }
      },
      "required": [
        "name",
        "fields",
        "traces"
      ],
      "title": "EntityModel",
      "type": "object"
    },
    "SchemaField": {
      "additionalProperties": false,
      "properties": {
        "itemRef": {
          "default": "",
          "title": "Itemref",
          "type": "string"
        },
        "maxLength": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maxlength"
        },
        "maximum": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum"
        },
        "minLength": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minlength"
        },
        "minimum": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "oneOf": {
          "items": {
            "type": "string"
          },
          "title": "Oneof",
          "type": "array"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "rules": {
          "items": {
            "type": "string"
          },
          "title": "Rules",
          "type": "array"
        },
        "type": {
          "default": "string",
          "enum": [
            "string",
            "number",
            "boolean",
            "date",
            "id",
            "object",
            "array"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "name",
        "type",
        "required",
        "itemRef",
        "minimum",
        "maximum",
        "minLength",
        "maxLength",
        "oneOf",
        "rules"
      ],
      "title": "SchemaField",
      "type": "object"
    }
  },
  "$id": "https://sdlc.local/contracts/api-contract.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The stored artefact: both arms, the comparison, and the choice.\n\n`contract` is the effective one downstream stages generate from. It equals\nthe chosen arm's output, or the recorded merge. The losing arm is kept\nwhole, because the evaluation compares arms and an artefact that kept only\nthe winner would have destroyed its own denominator.",
  "properties": {
    "chosen": {
      "default": "rule",
      "enum": [
        "rule",
        "llm",
        "merged"
      ],
      "title": "Chosen",
      "type": "string"
    },
    "comparison": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArmComparison"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "contract": {
      "$ref": "#/$defs/ApiContract"
    },
    "llmArm": {
      "anyOf": [
        {
          "$ref": "#/$defs/ApiContract"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "llmFailure": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Llmfailure"
    },
    "ruleArm": {
      "$ref": "#/$defs/ApiContract"
    },
    "ruleFindings": {
      "items": {
        "$ref": "#/$defs/ContractRuleFinding"
      },
      "title": "Rulefindings",
      "type": "array"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "version",
    "ruleArm",
    "llmArm",
    "llmFailure",
    "chosen",
    "contract",
    "comparison",
    "ruleFindings"
  ],
  "title": "ApiContractArtefact",
  "type": "object"
}
