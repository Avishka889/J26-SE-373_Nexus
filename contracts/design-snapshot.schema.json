    "StageModelUse": {
      "additionalProperties": false,
      "description": "The model use behind one stage's current version.\n\n`answered_by` names the models the responses named, which is what the\nprovider says answered rather than the string the component was configured\nwith. `requests` counts the responses received, output retries included.\nA stage that asked no model carries none of this.",
      "properties": {
        "answeredBy": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Answeredby",
          "type": "array"
        },
        "reasoningTokens": {
          "default": 0,
          "minimum": 0,
          "title": "Reasoningtokens",
          "type": "integer"
        },
        "requests": {
          "minimum": 1,
          "title": "Requests",
          "type": "integer"
        },
        "thinking": {
          "items": {
            "type": "string"
          },
          "title": "Thinking",
          "type": "array"
        },
        "tokensIn": {
          "minimum": 0,
          "title": "Tokensin",
          "type": "integer"
        },
        "tokensOut": {
          "minimum": 0,
          "title": "Tokensout",
          "type": "integer"
        }
      },
      "required": [
        "answeredBy",
        "thinking",
        "requests",
        "tokensIn",
        "tokensOut",
        "reasoningTokens"
      ],
      "title": "StageModelUse",
      "type": "object"
    },
