    "ConsistencyFinding": {
      "additionalProperties": false,
      "description": "Something two artefacts disagree about, for the reader at the gate.\n\nSeparate from `ValidationFinding`, which is carried on a single node and says\nthat one thing could not be confirmed. This is about the design as a whole:\na must-have with no story, a diagram naming a node the graph no longer has.\nNeither can be seen from inside the artefact it concerns, and both are read\nat the moment somebody decides whether to approve.\n\nDerived at read time and never stored. It is a statement about the current\nset of artefacts, so a stored copy would go stale exactly when it mattered:\nthe moment one of them is regenerated.",
      "properties": {
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "ruleId": {
          "minLength": 1,
          "title": "Ruleid",
          "type": "string"
        },
        "severity": {
          "enum": [
            "error",
            "warning"
          ],
          "title": "Severity",
          "type": "string"
        },
        "stageId": {
          "anyOf": [
            {
              "enum": [
                "requirements",
                "domain-model",
                "architecture-graph",
                "architecture-recommendation",
                "uml-diagrams",
                "wireframes",
                "sprint-plan",
                "design-review"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stageid"
        },
        "traces": {
          "items": {
            "pattern": "^R-\\d+$",
            "type": "string"
          },
          "title": "Traces",
          "type": "array"
        }
      },
      "required": [
        "ruleId",
        "severity",
        "reason",
        "traces",
        "stageId"
      ],
      "title": "ConsistencyFinding",
      "type": "object"
    },
