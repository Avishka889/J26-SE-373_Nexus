    "ValidationFinding": {
      "additionalProperties": false,
      "description": "A named rule check that could not confirm a node.\n\nCarried on the node itself rather than reported in a separate list, because a\nwarning the reader cannot trace to a cause is worse than no warning: the\ncanvas has to be able to say which rule fired, in plain words, and which\nrequirement the reader should go and look at.\n\n`rule_id` is the stable name of one of C1's rule checks, so the same finding\ncan be counted across runs for the evaluation. `reason` is written for the\nperson reading the design, and doubles as the repair hint the extraction loop\nfeeds back to the model.",
      "properties": {
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "ruleId": {
          "minLength": 1,
          "title": "Ruleid",
          "type": "string"
        },
        "traces": {
          "items": {
            "pattern": "^R-\\d+$",
            "type": "string"
          },
          "title": "Traces",
          "type": "array"
        }
      },
      "required": [
        "ruleId",
        "reason",
        "traces"
      ],
      "title": "ValidationFinding",
      "type": "object"
    },
