{
  "$defs": {
    "ChangelogAnalysis": {
      "additionalProperties": false,
      "description": "The changelog signal for one update.",
      "properties": {
        "claims": {
          "items": {
            "$ref": "#/$defs/ChangelogClaim"
          },
          "title": "Claims",
          "type": "array"
        },
        "model": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModelCall"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "notesFound": {
          "title": "Notesfound",
          "type": "boolean"
        },
        "refused": {
          "items": {
            "$ref": "#/$defs/RefusedClaim"
          },
          "title": "Refused",
          "type": "array"
        },
        "updateId": {
          "pattern": "^u-[0-9a-f]{12}$",
          "title": "Updateid",
          "type": "string"
        },
        "vote": {
          "$ref": "#/$defs/SignalVote"
        },
        "windows": {
          "items": {
            "type": "string"
          },
          "title": "Windows",
          "type": "array"
        }
      },
      "required": [
        "updateId",
        "windows",
        "notesFound",
        "claims",
        "refused",
        "vote",
        "model"
      ],
      "title": "ChangelogAnalysis",
      "type": "object"
    },
    "ChangelogClaim": {
      "additionalProperties": false,
      "description": "A claim that was checked and holds: the quote is in the notes, in the window.",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "breaking",
            "removal",
            "behavioural",
            "deprecation",
            "security",
            "fix",
            "feature",
            "other"
          ],
          "title": "Kind",
          "type": "string"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "sourceUrl": {
          "minLength": 1,
          "title": "Sourceurl",
          "type": "string"
        },
        "symbols": {
          "items": {
            "type": "string"
          },
          "title": "Symbols",
          "type": "array"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "symbols",
        "quote",
        "sourceUrl",
        "version"
      ],
      "title": "ChangelogClaim",
      "type": "object"
    },
    "ModelCall": {
      "additionalProperties": false,
      "description": "One call to the model, whatever came of it (NFR13).",
      "properties": {
        "completionTokens": {
          "default": 0,
          "minimum": 0,
          "title": "Completiontokens",
          "type": "integer"
        },
        "durationSeconds": {
          "default": 0.0,
          "minimum": 0,
          "title": "Durationseconds",
          "type": "number"
        },
        "error": {
          "default": "",
          "title": "Error",
          "type": "string"
        },
        "modelId": {
          "minLength": 1,
          "title": "Modelid",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "answered",
            "malformed",
            "cut-off",
            "rate-limited",
            "provider-error"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "promptId": {
          "minLength": 1,
          "title": "Promptid",
          "type": "string"
        },
        "promptSha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Promptsha256",
          "type": "string"
        },
        "promptTokens": {
          "default": 0,
          "minimum": 0,
          "title": "Prompttokens",
          "type": "integer"
        },
        "requests": {
          "default": 0,
          "minimum": 0,
          "title": "Requests",
          "type": "integer"
        },
        "settings": {
          "$ref": "#/$defs/ModelCallSettings"
        },
        "statedLevel": {
          "anyOf": [
            {
              "enum": [
                "low",
                "medium",
                "high"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Statedlevel"
        }
      },
      "required": [
        "modelId",
        "promptId",
        "promptSha256",
        "settings",
        "outcome",
        "requests",
        "promptTokens",
        "completionTokens",
        "durationSeconds",
        "error",
        "statedLevel"
      ],
      "title": "ModelCall",
      "type": "object"
    },
    "ModelCallSettings": {
      "additionalProperties": false,
      "description": "The settings the call was made with, recorded because they change answers.",
      "properties": {
        "maxTokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maxtokens"
        },
        "temperature": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature"
        },
        "thinking": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Thinking"
        }
      },
      "required": [
        "maxTokens",
        "thinking",
        "temperature"
      ],
      "title": "ModelCallSettings",
      "type": "object"
    },
    "RefusedClaim": {
      "additionalProperties": false,
      "description": "A claim the check refused, kept so the refusal rate is a result.",
      "properties": {
        "detail": {
          "default": "",
          "title": "Detail",
          "type": "string"
        },
        "kind": {
          "default": "",
          "title": "Kind",
          "type": "string"
        },
        "quote": {
          "default": "",
          "title": "Quote",
          "type": "string"
        },
        "reason": {
          "enum": [
            "quote-not-found",
            "outside-version-window",
            "empty-quote",
            "symbol-not-in-quote",
            "no-such-source"
          ],
          "title": "Reason",
          "type": "string"
        },
        "symbols": {
          "items": {
            "type": "string"
          },
          "title": "Symbols",
          "type": "array"
        },
        "version": {
          "default": "",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "quote",
        "version",
        "symbols",
        "reason",
        "detail"
      ],
      "title": "RefusedClaim",
      "type": "object"
    },
    "SignalVote": {
      "additionalProperties": false,
      "description": "One signal's answer for one update, or its reason for having none.",
      "properties": {
        "abstainedReason": {
          "default": "",
          "title": "Abstainedreason",
          "type": "string"
        },
        "evidenceIds": {
          "items": {
            "type": "string"
          },
          "title": "Evidenceids",
          "type": "array"
        },
        "level": {
          "anyOf": [
            {
              "enum": [
                "low",
                "medium",
                "high"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Level"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "ruleId": {
          "minLength": 1,
          "title": "Ruleid",
          "type": "string"
        },
        "signal": {
          "enum": [
            "semver",
            "changelog",
            "usage"
          ],
          "title": "Signal",
          "type": "string"
        }
      },
      "required": [
        "signal",
        "level",
        "abstainedReason",
        "ruleId",
        "rationale",
        "evidenceIds"
      ],
      "title": "SignalVote",
      "type": "object"
    }
  },
  "$id": "https://sdlc.local/contracts/changelog-report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The `changelog-report` artefact.",
  "properties": {
    "claimsRefused": {
      "readOnly": true,
      "title": "Claimsrefused",
      "type": "integer"
    },
    "claimsVerified": {
      "readOnly": true,
      "title": "Claimsverified",
      "type": "integer"
    },
    "generatedAt": {
      "title": "Generatedat",
      "type": "string"
    },
    "modelId": {
      "minLength": 1,
      "title": "Modelid",
      "type": "string"
    },
    "perUpdate": {
      "items": {
        "$ref": "#/$defs/ChangelogAnalysis"
      },
      "title": "Perupdate",
      "type": "array"
    },
    "promptId": {
      "minLength": 1,
      "title": "Promptid",
      "type": "string"
    },
    "promptSha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Promptsha256",
      "type": "string"
    },
    "refusalRate": {
      "readOnly": true,
      "title": "Refusalrate",
      "type": "number"
    },
    "ruleId": {
      "const": "changelog-rule/1",
      "default": "changelog-rule/1",
      "title": "Ruleid",
      "type": "string"
    },
    "stopReason": {
      "default": "",
      "title": "Stopreason",
      "type": "string"
    },
    "stoppedOnRateLimit": {
      "default": false,
      "title": "Stoppedonratelimit",
      "type": "boolean"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "version",
    "generatedAt",
    "modelId",
    "promptId",
    "promptSha256",
    "ruleId",
    "perUpdate",
    "stoppedOnRateLimit",
    "stopReason",
    "claimsVerified",
    "claimsRefused",
    "refusalRate"
  ],
  "title": "ChangelogReport",
  "type": "object"
}
