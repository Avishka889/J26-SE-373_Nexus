{
  "$defs": {
    "ArchitecturalLayout": {
      "additionalProperties": false,
      "description": "How the project is laid out, and the facts that decided it.",
      "properties": {
        "backendDir": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Backenddir"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "frontendDir": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frontenddir"
        },
        "kind": {
          "enum": [
            "one-process",
            "split",
            "backend-only",
            "frontend-only"
          ],
          "title": "Kind",
          "type": "string"
        },
        "servesFrontendFromBackend": {
          "title": "Servesfrontendfrombackend",
          "type": "boolean"
        },
        "sharedDirs": {
          "items": {
            "type": "string"
          },
          "title": "Shareddirs",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "frontendDir",
        "backendDir",
        "sharedDirs",
        "servesFrontendFromBackend",
        "evidence"
      ],
      "title": "ArchitecturalLayout",
      "type": "object"
    },
    "FileValidation": {
      "additionalProperties": false,
      "description": "One validator's verdict on one file.",
      "properties": {
        "findings": {
          "items": {
            "type": "string"
          },
          "title": "Findings",
          "type": "array"
        },
        "outcome": {
          "enum": [
            "passed",
            "failed",
            "not-run"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "reason": {
          "default": "",
          "title": "Reason",
          "type": "string"
        },
        "schemaRetrieved": {
          "default": "",
          "title": "Schemaretrieved",
          "type": "string"
        },
        "schemaUrl": {
          "default": "",
          "title": "Schemaurl",
          "type": "string"
        },
        "tool": {
          "default": "",
          "title": "Tool",
          "type": "string"
        },
        "validator": {
          "enum": [
            "json-schema",
            "yaml-parse",
            "actionlint",
            "hadolint",
            "kubeconform",
            "secret-scan"
          ],
          "title": "Validator",
          "type": "string"
        }
      },
      "required": [
        "validator",
        "tool",
        "schemaUrl",
        "schemaRetrieved",
        "outcome",
        "findings",
        "reason"
      ],
      "title": "FileValidation",
      "type": "object"
    },
    "PipelineFile": {
      "additionalProperties": false,
      "description": "One generated file.",
      "properties": {
        "bytes": {
          "minimum": 0,
          "title": "Bytes",
          "type": "integer"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "purpose": {
          "enum": [
            "workflow",
            "container",
            "hosting",
            "orchestration",
            "ignore",
            "lockfile",
            "fingerprint"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "secretsReferenced": {
          "items": {
            "type": "string"
          },
          "title": "Secretsreferenced",
          "type": "array"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "templateId": {
          "minLength": 1,
          "title": "Templateid",
          "type": "string"
        },
        "valid": {
          "description": "Every validator that applies to it ran, and passed.",
          "readOnly": true,
          "title": "Valid",
          "type": "boolean"
        },
        "validations": {
          "items": {
            "$ref": "#/$defs/FileValidation"
          },
          "title": "Validations",
          "type": "array"
        }
      },
      "required": [
        "path",
        "purpose",
        "sha256",
        "bytes",
        "templateId",
        "secretsReferenced",
        "validations",
        "valid"
      ],
      "title": "PipelineFile",
      "type": "object"
    },
    "StackSupport": {
      "additionalProperties": false,
      "description": "Whether this stack has validated templates, and if not, why (FR14).",
      "properties": {
        "layout": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArchitecturalLayout"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reason": {
          "default": "",
          "title": "Reason",
          "type": "string"
        },
        "stackId": {
          "minLength": 1,
          "title": "Stackid",
          "type": "string"
        },
        "supported": {
          "title": "Supported",
          "type": "boolean"
        }
      },
      "required": [
        "stackId",
        "supported",
        "reason",
        "layout"
      ],
      "title": "StackSupport",
      "type": "object"
    }
  },
  "$id": "https://sdlc.local/contracts/pipeline-config.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The `pipeline-config` artefact.",
  "properties": {
    "candidateHash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Candidatehash",
      "type": "string"
    },
    "codeVersion": {
      "minimum": 1,
      "title": "Codeversion",
      "type": "integer"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/PipelineFile"
      },
      "title": "Files",
      "type": "array"
    },
    "generatedAt": {
      "title": "Generatedat",
      "type": "string"
    },
    "kubernetes": {
      "enum": [
        "generated",
        "skipped"
      ],
      "title": "Kubernetes",
      "type": "string"
    },
    "kubernetesReason": {
      "default": "",
      "title": "Kubernetesreason",
      "type": "string"
    },
    "stack": {
      "$ref": "#/$defs/StackSupport"
    },
    "valid": {
      "description": "NFR5: a supported stack whose every generated file is valid.",
      "readOnly": true,
      "title": "Valid",
      "type": "boolean"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "version",
    "generatedAt",
    "codeVersion",
    "candidateHash",
    "stack",
    "files",
    "kubernetes",
    "kubernetesReason",
    "valid"
  ],
  "title": "PipelineConfig",
  "type": "object"
}
