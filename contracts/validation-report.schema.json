{
  "$defs": {
    "CvssFactors": {
      "additionalProperties": false,
      "description": "The CVSS v3.1 base metrics. Inputs, so the score is checkable.\n\nKept as the metric letters rather than numbers because that is what the\nvector string carries and what a reader can compare against a published\nCVE. The weights live in the scoring code, once.",
      "properties": {
        "attackComplexity": {
          "enum": [
            "L",
            "H"
          ],
          "title": "Attackcomplexity",
          "type": "string"
        },
        "attackVector": {
          "enum": [
            "N",
            "A",
            "L",
            "P"
          ],
          "title": "Attackvector",
          "type": "string"
        },
        "availability": {
          "enum": [
            "N",
            "L",
            "H"
          ],
          "title": "Availability",
          "type": "string"
        },
        "confidentiality": {
          "enum": [
            "N",
            "L",
            "H"
          ],
          "title": "Confidentiality",
          "type": "string"
        },
        "integrity": {
          "enum": [
            "N",
            "L",
            "H"
          ],
          "title": "Integrity",
          "type": "string"
        },
        "privilegesRequired": {
          "enum": [
            "N",
            "L",
            "H"
          ],
          "title": "Privilegesrequired",
          "type": "string"
        },
        "scope": {
          "enum": [
            "U",
            "C"
          ],
          "title": "Scope",
          "type": "string"
        },
        "userInteraction": {
          "enum": [
            "N",
            "R"
          ],
          "title": "Userinteraction",
          "type": "string"
        },
        "vector": {
          "readOnly": true,
          "title": "Vector",
          "type": "string"
        }
      },
      "required": [
        "attackVector",
        "attackComplexity",
        "privilegesRequired",
        "userInteraction",
        "scope",
        "confidentiality",
        "integrity",
        "availability",
        "vector"
      ],
      "title": "CvssFactors",
      "type": "object"
    },
    "DetectorRun": {
      "additionalProperties": false,
      "description": "One arm's pass over one target: the operational half of the study.\n\nCost, latency and offline operation are reported beside accuracy because\nthe trained arm's argument is largely made of them, and a comparison that\nreports only F1 cannot see it.",
      "properties": {
        "arm": {
          "enum": [
            "scanner",
            "llm",
            "trained"
          ],
          "title": "Arm",
          "type": "string"
        },
        "completionTokens": {
          "default": 0,
          "minimum": 0,
          "title": "Completiontokens",
          "type": "integer"
        },
        "costUsd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Costusd"
        },
        "durationSeconds": {
          "minimum": 0,
          "title": "Durationseconds",
          "type": "number"
        },
        "filesScanned": {
          "default": 0,
          "minimum": 0,
          "title": "Filesscanned",
          "type": "integer"
        },
        "modelId": {
          "minLength": 1,
          "title": "Modelid",
          "type": "string"
        },
        "offline": {
          "title": "Offline",
          "type": "boolean"
        },
        "promptTokens": {
          "default": 0,
          "minimum": 0,
          "title": "Prompttokens",
          "type": "integer"
        },
        "startedAt": {
          "title": "Startedat",
          "type": "string"
        }
      },
      "required": [
        "arm",
        "modelId",
        "startedAt",
        "durationSeconds",
        "promptTokens",
        "completionTokens",
        "costUsd",
        "offline",
        "filesScanned"
      ],
      "title": "DetectorRun",
      "type": "object"
    },
    "EvidenceSpan": {
      "additionalProperties": false,
      "description": "Where in the repository the finding is, precisely enough to check.\n\nA span rather than a line, because a taint finding is a flow and a reader\nasked to confirm one line of it is being asked to trust the rest.",
      "properties": {
        "endLine": {
          "minimum": 1,
          "title": "Endline",
          "type": "integer"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "snippet": {
          "default": "",
          "title": "Snippet",
          "type": "string"
        },
        "startLine": {
          "minimum": 1,
          "title": "Startline",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "startLine",
        "endLine",
        "snippet"
      ],
      "title": "EvidenceSpan",
      "type": "object"
    },
    "RefusedFinding": {
      "additionalProperties": false,
      "description": "A finding that was thrown away, and why. Counted, never silent.\n\nThe refusal rate is a result about the arm that produced it: an arm whose\nevidence does not resolve is an arm inventing locations, and dropping those\nquietly would flatter it in exactly the comparison this component exists to\nrun.",
      "properties": {
        "claimedPath": {
          "default": "",
          "title": "Claimedpath",
          "type": "string"
        },
        "claimedStartLine": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Claimedstartline"
        },
        "cwe": {
          "default": "",
          "title": "Cwe",
          "type": "string"
        },
        "detail": {
          "default": "",
          "title": "Detail",
          "type": "string"
        },
        "origin": {
          "enum": [
            "scanner",
            "llm",
            "trained"
          ],
          "title": "Origin",
          "type": "string"
        },
        "reason": {
          "enum": [
            "file-not-found",
            "span-out-of-range",
            "snippet-does-not-match",
            "malformed-cwe",
            "no-evidence"
          ],
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "origin",
        "cwe",
        "reason",
        "claimedPath",
        "claimedStartLine",
        "detail"
      ],
      "title": "RefusedFinding",
      "type": "object"
    },
    "SecurityFinding": {
      "additionalProperties": false,
      "properties": {
        "baseScore": {
          "readOnly": true,
          "title": "Basescore",
          "type": "number"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "confidenceSource": {
          "enum": [
            "arm-agreement",
            "scanner-rule",
            "calibration"
          ],
          "title": "Confidencesource",
          "type": "string"
        },
        "cwe": {
          "pattern": "^CWE-\\d+$",
          "title": "Cwe",
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/EvidenceSpan"
        },
        "explanation": {
          "default": "",
          "title": "Explanation",
          "type": "string"
        },
        "factors": {
          "$ref": "#/$defs/CvssFactors"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "scanner",
            "llm",
            "trained",
            "merged"
          ],
          "title": "Origin",
          "type": "string"
        },
        "raisedBy": {
          "items": {
            "enum": [
              "scanner",
              "llm",
              "trained"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Raisedby",
          "type": "array"
        },
        "remediation": {
          "default": "",
          "title": "Remediation",
          "type": "string"
        },
        "runId": {
          "default": "",
          "title": "Runid",
          "type": "string"
        },
        "severity": {
          "enum": [
            "none",
            "low",
            "medium",
            "high",
            "critical"
          ],
          "readOnly": true,
          "title": "Severity",
          "type": "string"
        },
        "severityReasoning": {
          "default": "",
          "title": "Severityreasoning",
          "type": "string"
        },
        "status": {
          "default": "open",
          "enum": [
            "open",
            "dismissed",
            "fix-proposed",
            "re-verifying",
            "verified"
          ],
          "title": "Status",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "cwe",
        "title",
        "origin",
        "raisedBy",
        "evidence",
        "factors",
        "status",
        "explanation",
        "remediation",
        "confidence",
        "confidenceSource",
        "severityReasoning",
        "runId",
        "baseScore",
        "severity"
      ],
      "title": "SecurityFinding",
      "type": "object"
    },
    "TestSummary": {
      "additionalProperties": false,
      "description": "The test side in one block, so C4 reads one artefact rather than two.",
      "properties": {
        "failed": {
          "minimum": 0,
          "title": "Failed",
          "type": "integer"
        },
        "lineCoverage": {
          "maximum": 100,
          "minimum": 0,
          "title": "Linecoverage",
          "type": "number"
        },
        "mutationScore": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mutationscore"
        },
        "passed": {
          "minimum": 0,
          "title": "Passed",
          "type": "integer"
        },
        "run": {
          "minimum": 0,
          "title": "Run",
          "type": "integer"
        },
        "skipped": {
          "minimum": 0,
          "title": "Skipped",
          "type": "integer"
        }
      },
      "required": [
        "run",
        "passed",
        "failed",
        "skipped",
        "lineCoverage",
        "mutationScore"
      ],
      "title": "TestSummary",
      "type": "object"
    },
    "ToolOutcome": {
      "additionalProperties": false,
      "description": "One scanning tool in a pass: whether it ran, and if not, why.\n\nA tool that failed and a tool that found nothing look the same in a list of\nzero findings, and only one of them is a result. The failure reached only\nthe stage's notes, so the Security step could not say that npm audit had\nnever run on a generated app (review item C3-5).",
      "properties": {
        "detail": {
          "default": "",
          "title": "Detail",
          "type": "string"
        },
        "ran": {
          "title": "Ran",
          "type": "boolean"
        },
        "tool": {
          "minLength": 1,
          "title": "Tool",
          "type": "string"
        },
        "version": {
          "default": "",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "tool",
        "ran",
        "version",
        "detail"
      ],
      "title": "ToolOutcome",
      "type": "object"
    }
  },
  "$id": "https://sdlc.local/contracts/validation-report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "approvedAt": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Approvedat"
    },
    "approvedBy": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Approvedby"
    },
    "detectorRuns": {
      "items": {
        "$ref": "#/$defs/DetectorRun"
      },
      "title": "Detectorruns",
      "type": "array"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/SecurityFinding"
      },
      "title": "Findings",
      "type": "array"
    },
    "generatedAt": {
      "title": "Generatedat",
      "type": "string"
    },
    "openCriticalOrHigh": {
      "readOnly": true,
      "title": "Opencriticalorhigh",
      "type": "integer"
    },
    "openFindings": {
      "readOnly": true,
      "title": "Openfindings",
      "type": "integer"
    },
    "refusedCount": {
      "readOnly": true,
      "title": "Refusedcount",
      "type": "integer"
    },
    "refusedEvidence": {
      "items": {
        "$ref": "#/$defs/RefusedFinding"
      },
      "title": "Refusedevidence",
      "type": "array"
    },
    "reportVersion": {
      "default": "1.0.0",
      "title": "Reportversion",
      "type": "string"
    },
    "target": {
      "minLength": 1,
      "title": "Target",
      "type": "string"
    },
    "tests": {
      "$ref": "#/$defs/TestSummary"
    },
    "tools": {
      "items": {
        "$ref": "#/$defs/ToolOutcome"
      },
      "title": "Tools",
      "type": "array"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "reportVersion",
    "version",
    "generatedAt",
    "target",
    "findings",
    "refusedEvidence",
    "detectorRuns",
    "tools",
    "tests",
    "approvedBy",
    "approvedAt",
    "openFindings",
    "openCriticalOrHigh",
    "refusedCount"
  ],
  "title": "ValidationReport",
  "type": "object"
}
