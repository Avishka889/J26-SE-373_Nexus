# Copy to .env and fill in. .env is gitignored and must never be committed.
# Use LF line endings: a CRLF file breaks shell sourcing.
#
# Every setting the platform reads is here. A commented line shows the default
# and only needs uncommenting to change it. Lines marked "process environment"
# are read by a component directly rather than by the orchestrator's settings,
# so they take effect only when the orchestrator starts with
# `uv run --env-file ../.env ...` (docs/Setup_Guide.md, section 7). The frontend
# has its own template: ai-sdlc-platform-frontend/.env.example.

# ---------------------------------------------------------------- database
# Everything is selected by these two, so switching between a Neon branch and
# the compose Postgres is a change here and nowhere else.
#
# Daily development is your own Neon branch (dev-<name>). `main` is the shared
# integration and demo database. The compose Postgres is for offline work and
# the backend tests; CI brings its own.
#
# Pooled: used by the application. Neon pooled hosts carry "-pooler".
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require
# Direct, NOT pooled: used by the LangGraph checkpointer, which holds its own
# connections and does not work through a transaction pooler.
DATABASE_DIRECT_URL=postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require

# The compose path instead, for offline work. `docker compose up -d --wait db`
# serves it on localhost:5433 (5432 is its port inside the container):
# DATABASE_URL=postgresql://sdlc:sdlc@localhost:5433/sdlc
# DATABASE_DIRECT_URL=postgresql://sdlc:sdlc@localhost:5433/sdlc

# Where the test suite writes. REQUIRED to run the backend tests, and it must
# not be the database above: the suite deletes projects, settings rows and
# stored credentials, and it once deleted a real GitHub token by sharing one.
# `docker compose up -d db` serves this; the database itself is created on the
# first run. A Neon test branch works here too, which is what the pre-milestone
# run uses, because a local Postgres has no pooler and the restart tests were
# written against Neon's pooled versus direct split. Read by the test suite from
# the process environment: `uv run --env-file .env pytest ...`.
TEST_DATABASE_URL=postgresql://sdlc:sdlc@localhost:5433/sdlc_test

# ------------------------------------------------------------ orchestrator
# The dev server origins allowed through CORS, comma separated.
CORS_ORIGINS=http://localhost:5173
# Encrypts provider tokens at rest. Generate with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Empty disables the secret store rather than storing tokens in plaintext.
SECRET_KEY=

# How many days a sign-in lasts before the browser signs in again.
# SESSION_DAYS=30
# Mark the session cookie Secure, so a browser sends it over HTTPS only. On for
# any deployment; off here because the platform runs on http://localhost.
# SESSION_COOKIE_SECURE=false
# The identity that rows from before sign-in existed belong to, which the first
# account registered takes over (migration 0003). Leave it as it is.
# PRE_SIGN_IN_OWNER_ID=u_local_dev

# ------------------------------------------------- reaching the components
# How the orchestrator reaches each component. `inprocess` imports it directly
# and is the default for development; `http` calls the running service, which is
# what compose and production use. The boundary is real either way. Component 3
# runs in process only for now: its client can speak HTTP, and no C3 server
# exists to answer it yet.
C1_MODE=inprocess
C1_BASE_URL=http://localhost:8001
C2_MODE=inprocess
C2_BASE_URL=http://localhost:8002
C3_MODE=inprocess
C3_BASE_URL=http://localhost:8003
C4_MODE=inprocess
C4_BASE_URL=http://localhost:8004

# ------------------------------------------- Component 2, code generation
# Whether the page writer rewrites the rule-built pages for what each one is
# for. On, because the rule pages alone made every app the same form; each page
# is compiled before it ships, and one that does not compile goes back.
C2_PAGE_FILL=true

# ---------------------------------------- Component 3, testing and security
# Which detection arms the security stage runs, comma separated. `scanner` is
# required: it needs no key, spends nothing, and is what the other arms are
# measured against. Add `llm` to spend tokens on every testing run, and
# `trained` with C3_TRAINED_MODEL_DIR below. The trained model reads Java only,
# so on a generated MERN app it has nothing to read; the seeded Java sample is
# where all three run together. Restart the orchestrator after a change.
C3_DETECTION_ARMS=scanner
# The fine tuned weights for the trained arm, as an absolute path. Empty means
# no trained arm, whatever the line above says.
C3_TRAINED_MODEL_DIR=
# Process environment. The Python that serves the trained model, which holds
# torch and transformers so the workspace does not have to. Default:
# ~/venvs/c3-torch/bin/python (docs/Setup_Guide.md, section 10.1).
# C3_MODEL_PYTHON=
# Where a generated project is written out for a test lane to run it. Outside
# the repository, because a lane installs packages and runs mutation.
# C3_WORKSPACE_ROOT=/tmp/c3-workspaces
# Process environment. The home every sandboxed test step runs under, shared
# across runs so the npm and Maven caches survive. Default: <temp dir>/c3-home.
# C3_SANDBOX_HOME=
# Process environment. Where the scanner looks for a FindSecBugs jar Maven has
# already fetched. Default: ~/.m2/repository.
# MAVEN_HOME_REPO=

# ------------------------------------- Component 4, deployment and updates
# Where a release goes when nobody has chosen: `local`, containers on this
# machine, or `cloud`.
C4_RELEASE_TARGET_DEFAULT=local
# Off unless a deployment turns it on: with it off, a cloud release is refused
# before anything is dispatched. Cloud releases are presenter driven, on
# sandboxed accounts only.
C4_CLOUD_ENABLED=false
# The first local release port, on loopback only. Each project takes its own,
# from this one up, and keeps it.
# C4_LOCAL_RELEASE_PORT=18080
# The label the local release containers carry, so a restart finds them and the
# tests, which use a lane of their own, never touch them.
# C4_LOCAL_LANE=release
# Where staging writes a candidate out to build it, and where registry answers
# and fetched release notes are kept between runs.
# C4_WORKSPACE_ROOT=/tmp/c4-workspaces
# C4_CACHE_DIR=/tmp/c4-cache
# Process environment. The Roseau launcher that diffs a Java library's API, when
# it is not where `uv run python -m c4.impact.tools install` puts it, under
# ~/.cache/sdlc-c4/tools.
# C4_ROSEAU=

# Watching a release after it goes out. Each window probes the release's health
# address every C4_MONITOR_INTERVAL_SECONDS for C4_MONITOR_WINDOW_SECONDS, and
# every release gets one window when it goes live. These are the defaults; a
# line only needs uncommenting to change one. Restart the orchestrator after a
# change: settings are read once, at startup.
# C4_MONITOR_INTERVAL_SECONDS=30
# C4_MONITOR_WINDOW_SECONDS=600
# A window again on what still serves: every six hours (21600), for a week
# (604800) after it went out. Set either to 0 for never.
# C4_MONITOR_EVERY_SECONDS=21600
# C4_MONITOR_FOR_SECONDS=604800
# Off, the repeat windows watch a local release only. Set to true to watch a
# cloud release again too. Each window is ten minutes of requests to the live
# host, four times a day for a week, and it wakes a free Render service every
# time, which spends its monthly free hours on being watched.
C4_MONITOR_CLOUD_AGAIN=false

# ---------------------------------------------------------------------- llm
# Model strings are configuration, never hardcoded. Each phase has its own line,
# C1_MODEL to C4_MODEL, and the prefix of each chooses its provider, whose key
# must then be set. C1's key is checked at startup and a missing one stops the
# orchestrator. A missing key for C2, C3 or C4 does not: that phase starts as
# not configured and its stages fail until the key is added and the server
# restarted. Several keys can be set at once: swapping provider for a
# comparison run is then a change to one line.
#
# DeepSeek is what the code runs for any phase whose line is missing, and what
# this template sets for all four: metered and cheap, with no daily request cap.
# The other prefixes, each reading its own key:
#
#   anthropic:claude-sonnet-5          ANTHROPIC_API_KEY
#   anthropic:claude-haiku-4-5         ANTHROPIC_API_KEY, a third the price
#   google:<a gemini model>            GOOGLE_API_KEY, free tier
#   openrouter:<vendor>/<model>        OPENROUTER_API_KEY, free tier, one key for many models
#
# Groq is still installed and the prefix still selects it, but as of 2026-08-17 it
# has nothing C1 can use: llama-3.3-70b-versatile was decommissioned and returns
# 404, the gpt-oss models cap the free tier at 8000 tokens a minute while one C1
# request needs about 11600, groq/compound does not support tool calling at all,
# and qwen cannot hold the requirements schema. Naming one here would send a
# reader to a model that fails.
#
# Before wiring any new provider, ask it in one call rather than in a run. Each
# component has its own probe, run from its service directory:
#
#   cd services/c1-requirements-design && uv run python -m c1.probe <model string>
#
# and likewise c2.probe, c3.probe and c4.probe.
#
# Pin the exact model for evaluation runs and record which one produced a design.
C1_MODEL=deepseek:deepseek-flash
C2_MODEL=deepseek:deepseek-flash
C3_MODEL=deepseek:deepseek-flash
C4_MODEL=deepseek:deepseek-flash

# How much room one answer gets. Left blank, each provider gets what it needs:
# pydantic-ai caps Anthropic at 4096 output tokens, which is not enough for the
# architecture graph of a large brief, so C1 raises that one and leaves every
# other provider on its own default. Set a number here to pin the same ceiling
# across providers for an evaluation run. Process environment, like the three
# beside it, which do the same for the other phases.
C1_MAX_OUTPUT_TOKENS=
# C2_MAX_OUTPUT_TOKENS=65536
# C3_MAX_OUTPUT_TOKENS=
# C4_MAX_OUTPUT_TOKENS=

# How hard each phase asks its model to think: off, low, high or max. Off, the
# default, is what every phase has always sent: DeepSeek's thinking off and the
# answer as a forced tool call. The others turn DeepSeek's thinking on at that
# effort and take the answer as JSON instead, because DeepSeek refuses a forced
# tool call while it thinks. Leave them off until a probe shows a phase's
# answers hold with thinking on; every run records the level it ran at.
C1_THINKING=off
C2_THINKING=off
C3_THINKING=off
C4_THINKING=off
# Only the keys the four model lines name are read. The rest may stay blank.
ANTHROPIC_API_KEY=
# Metered and cheap, and the only lane with no daily request cap. `deepseek-flash`
# off peak is $0.15 per 1M in and $0.60 per 1M out, so a full benchmark slice is
# a few cents. Use `deepseek-flash`, never `deepseek-reasoner`: forced tool calls
# are refused with a 400 in thinking mode, and every structured output here is one.
DEEPSEEK_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
