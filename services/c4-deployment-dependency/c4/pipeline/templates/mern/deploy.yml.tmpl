# Generated by the platform (C4) from <<template_id>>. The platform dispatches
# it twice after a person approves the release; a push never runs it. The test
# stage tests the commit and builds its frontend, before anything moves
# traffic. Only then does the platform deploy the commit's backend on Render
# itself, through Render's API, so no Render credential lives in this
# repository. The deploy stage deploys the frontend on Vercel, and ends by
# checking that both serve the approved candidate.
name: Deploy

on:
  workflow_dispatch:
    inputs:
      stage:
        description: test, to test and build the commit; deploy, to deploy its frontend and verify both
        required: true
        type: choice
        options:
          - test
          - deploy
      ref:
        description: The commit to deploy, as a full SHA
        required: true
        type: string
      candidate_hash:
        description: The candidate the release must serve in release.json
        required: true
        type: string
      backend_origin:
        description: Where the backend answers
        required: true
        type: string
        default: <<backend_origin>>
      frontend_origin:
        description: Where the frontend answers
        required: true
        type: string
        default: <<frontend_origin>>

permissions:
  contents: read

concurrency:
  group: production
  cancel-in-progress: false

jobs:
  test:
    name: Test and build the commit
    if: inputs.stage == 'test'
    runs-on: ubuntu-latest
    timeout-minutes: 20
    steps:
      - name: Check the inputs
        env:
          REF: ${{ inputs.ref }}
          CANDIDATE: ${{ inputs.candidate_hash }}
        run: |
          [[ "$REF" =~ ^[0-9a-f]{40}$ ]] || { echo "ref must be a full commit SHA" >&2; exit 1; }
          [[ "$CANDIDATE" =~ ^[0-9a-f]{64}$ ]] || { echo "candidate_hash must be a sha256" >&2; exit 1; }
      - uses: actions/checkout@<<checkout_sha>> # <<checkout_version>>
        with:
          ref: ${{ inputs.ref }}
          persist-credentials: false
      - uses: actions/setup-node@<<setup_node_sha>> # <<setup_node_version>>
        with:
          node-version: <<node_version>>
          cache: npm
      - run: npm ci --no-audit --no-fund
      - run: npm run typecheck
      - run: npm test
      # The frontend built as production builds it, before anything moves traffic.
      - run: echo "VITE_API_URL=/api" > <<frontend_dir>>/.env.production.local
      - run: npm run build
      - name: Check the commit is the approved candidate
        env:
          CANDIDATE: ${{ inputs.candidate_hash }}
        run: |
          named=$(jq -r .candidateHash <<fingerprint_path>>)
          [ "$named" = "$CANDIDATE" ] || { echo "this commit is candidate $named, not $CANDIDATE" >&2; exit 1; }

  frontend:
    name: Deploy the frontend on Vercel
    # The commit the test stage tested and built: the platform dispatches this
    # stage with the same ref, and only once that stage succeeded.
    if: inputs.stage == 'deploy'
    runs-on: ubuntu-latest
    timeout-minutes: 20
<<environment>>    env:
      VERCEL_ORG_ID: ${{ secrets.VERCEL_ORG_ID }}
      VERCEL_PROJECT_ID: ${{ secrets.VERCEL_PROJECT_ID }}
      VERCEL_TOKEN: ${{ secrets.VERCEL_TOKEN }}
    steps:
      - uses: actions/checkout@<<checkout_sha>> # <<checkout_version>>
        with:
          ref: ${{ inputs.ref }}
          persist-credentials: false
      - uses: actions/setup-node@<<setup_node_sha>> # <<setup_node_version>>
        with:
          node-version: <<node_version>>
          cache: npm
      - run: npm install --global vercel@<<vercel_version>>
      - run: vercel pull --yes --environment=production --token="$VERCEL_TOKEN"
      # The frontend calls the backend through Vercel's /api rewrite, so it
      # needs no CORS; Vite reads this file when it builds for production.
      - run: echo "VITE_API_URL=/api" > <<frontend_dir>>/.env.production.local
      - run: vercel build --prod --token="$VERCEL_TOKEN"
      - run: vercel deploy --prebuilt --prod --token="$VERCEL_TOKEN"
      - name: Wait for the frontend to serve the candidate
        env:
          ORIGIN: ${{ inputs.frontend_origin }}
          CANDIDATE: ${{ inputs.candidate_hash }}
        run: |
          for attempt in $(seq 1 60); do
            served=$(curl --fail --silent --max-time 20 "$ORIGIN/release.json" | jq -r .candidateHash 2>/dev/null || true)
            if [ "$served" = "$CANDIDATE" ]; then echo "serving the candidate after $attempt checks"; exit 0; fi
            sleep 10
          done
          echo "$ORIGIN did not serve the candidate within 10 minutes" >&2
          exit 1

  verify:
    name: Verify the release
    needs: frontend
    uses: ./.github/workflows/verify-release.yml
    with:
      candidate_hash: ${{ inputs.candidate_hash }}
      backend_origin: ${{ inputs.backend_origin }}
      frontend_origin: ${{ inputs.frontend_origin }}
