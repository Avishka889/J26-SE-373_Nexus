# Generated by the platform (C4) from <<template_id>>. Checks that a release
# is what was approved and that it answers: both origins serve the candidate's
# fingerprint and their page, and every smoke request answers with JSON on the
# backend and through the frontend's /api rewrite. A smoke request asks for
# JSON because the backend answers any request for a page with the app's
# index.html, so a status alone would pass for an endpoint that is not there.
# The deploy workflow ends with it, and the platform runs it alone after a
# rollback.
name: Verify release

on:
  workflow_call:
    inputs:
      candidate_hash:
        required: true
        type: string
      backend_origin:
        required: true
        type: string
      frontend_origin:
        required: true
        type: string
  workflow_dispatch:
    inputs:
      candidate_hash:
        description: The candidate both origins must serve in release.json
        required: true
        type: string
      backend_origin:
        description: Where the backend answers
        required: true
        type: string
        default: <<backend_origin>>
      frontend_origin:
        description: Where the frontend answers
        required: true
        type: string
        default: <<frontend_origin>>

permissions:
  contents: read

jobs:
  verify:
    name: Fingerprint and smoke
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - name: Check both origins serve the candidate
        env:
          CANDIDATE: ${{ inputs.candidate_hash }}
          BACKEND: ${{ inputs.backend_origin }}
          FRONTEND: ${{ inputs.frontend_origin }}
        run: |
          for origin in "$BACKEND" "$FRONTEND"; do
            served=$(curl --fail --silent --show-error --max-time 60 "$origin/release.json" | jq -r .candidateHash)
            [ "$served" = "$CANDIDATE" ] || { echo "$origin serves $served, not $CANDIDATE" >&2; exit 1; }
          done
      - name: Check both origins serve the page
        env:
          BACKEND: ${{ inputs.backend_origin }}
          FRONTEND: ${{ inputs.frontend_origin }}
        run: |
          for origin in "$BACKEND" "$FRONTEND"; do
            type=$(curl --fail --silent --show-error --max-time 60 --header "Accept: text/html" --output /dev/null --write-out '%{content_type}' "$origin/")
            [[ "$type" == text/html* ]] || { echo "$origin/ answered $type, not a page" >&2; exit 1; }
          done
      - name: Check every smoke request answers with JSON
        env:
          BACKEND: ${{ inputs.backend_origin }}
          FRONTEND: ${{ inputs.frontend_origin }}
        run: |
          for path in <<smoke_paths>>; do
            for url in "$BACKEND$path" "$FRONTEND/api$path"; do
              type=$(curl --fail --silent --show-error --max-time 60 --header "Accept: application/json" --output /dev/null --write-out '%{content_type}' "$url")
              [[ "$type" == application/json* ]] || { echo "$url answered $type, not JSON" >&2; exit 1; }
            done
          done
