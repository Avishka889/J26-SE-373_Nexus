# Generated by the platform (C4) from <<template_id>>.
# The backend on Render, built from the Dockerfile beside this file. It deploys
# only when the platform calls its deploy hook with a commit, never on a push,
# and each secret is declared here by name and given its value on Render.
services:
  - type: web
    name: <<service_name>>
    runtime: docker
    plan: free
    dockerfilePath: ./Dockerfile
    dockerContext: .
    healthCheckPath: <<health_path>>
    autoDeployTrigger: "off"
<<env_vars>>
