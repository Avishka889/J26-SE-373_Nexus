# Generated by the platform (C4) from mern/Dockerfile@2, and regenerated on every
# release: change the template, not this file. One image for the one-process
# layout: the backend serves the built frontend, so one container is the app.

# The toolchain every stage runs on, pinned by digest.
FROM node:22-bookworm-slim@sha256:43ac6c60b8f89723f746e8a92ce91abd5017e627ce1ddfe4238355d3a30b772c AS deps
WORKDIR /app
# The manifests and the lockfile first, so the install layer is reused until
# one of them changes.
COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY packages/contract/package.json packages/contract/
RUN --mount=type=cache,target=/root/.npm npm ci --no-audit --no-fund

# The tests the release depends on. The build stage copies their marker, so no
# image can be built from code whose tests fail.
FROM deps AS test
COPY . .
RUN npm run typecheck && npm test && touch /tmp/tested

FROM deps AS build
COPY . .
COPY --from=test /tmp/tested /tmp/tested
RUN npm run build && npm prune --omit=dev --no-audit --no-fund

# What runs: the sources node runs directly, production dependencies only, and
# the built frontend. The start command is the backend's own start script, run
# as the image's node user, by number so a runtime can verify it is not root.
FROM node:22-bookworm-slim@sha256:43ac6c60b8f89723f746e8a92ce91abd5017e627ce1ddfe4238355d3a30b772c AS runtime
ENV NODE_ENV=production
COPY --from=build /app /app
WORKDIR /app/apps/api
USER 1000:1000
EXPOSE 3001
CMD ["node", "--experimental-strip-types", "src/server.ts"]
