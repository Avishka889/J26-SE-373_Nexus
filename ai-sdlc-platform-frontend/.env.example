# Orchestrator base URL (public; never put private keys in VITE_* vars)
VITE_API_URL=http://localhost:8000

# Which features read the real backend, comma separated, in the fixture modes
# only (`npm run dev -- --mode fixtures`, Playwright, vitest). Fixtures are
# unwired from the running app: development and production builds read every
# feature from the backend whatever this says. In a fixture mode, everything not
# named here reads fixtures, and empty means the whole product runs on them. An
# unknown name fails the build rather than falling back (the Vite config parses
# the list), because a typo in this list produces a demo that looks right and is
# not.
#
# Known: projects, requirements, activity, settings, testing, code-generation,
# deployment
#
# `requirements` cannot be live without `projects`: a design belongs to a project,
# and the fixture store answers an unknown project id with a blank rather than an
# error. The committed default lives in .env.development.
VITE_LIVE_FEATURES=
