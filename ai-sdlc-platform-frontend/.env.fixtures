# The whole product on fixtures, whatever .env.development says: the one way
# to run the app on them now that the running app is unwired from them.
#
# Committed, and used by `npm run dev -- --mode fixtures` and by the Playwright
# suite. Those checks assert things about four authored demo projects, so pointing
# them at a real backend would make them assert things about whatever happens to
# be in a shared database.
#
# A mode file rather than an environment variable on the command line: Vite does
# not treat an empty VITE_ value in the environment as set, so `VITE_LIVE_FEATURES=`
# passed that way silently loses to .env.development. That is how this was found.
VITE_API_URL=http://localhost:8000
VITE_LIVE_FEATURES=
