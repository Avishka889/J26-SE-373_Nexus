{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,

    /*
     * ES2022.Error is here for one reason only: Error's cause option. ESLint's
     * preserve-caught-error rule (on via js.configs.recommended) requires that
     * when a catch block throws a replacement error, the original is attached
     * as new Error(message, { cause }). The base ES2020 lib has no two-argument
     * Error constructor, so without this entry that call fails to typecheck.
     * Adding it is purely additive: it just types a runtime feature every
     * browser this project targets already ships.
     */
    "lib": ["ES2020", "ES2022.Error", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "types": ["node"],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Path mapping */
    "baseUrl": ".",
    "paths": {
      "@sdlc/contracts-ts": ["../packages/contracts-ts/src/index.ts"],
      "@/*": ["src/*"]
    },

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "vite.config.ts"]
}
