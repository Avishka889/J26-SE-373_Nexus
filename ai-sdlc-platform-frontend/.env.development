# Committed on purpose. Fixtures are unwired from the running app: in
# development and in a production build every feature reads the backend,
# whatever the list below says (`liveFeaturesFor` in src/lib/liveFeatures.ts).
# The list still has to name real features, since a typo fails the build, and
# it records the order the components landed in; it decides where data comes
# from only in the fixture modes, for the tests (.env.fixtures).
VITE_API_URL=http://localhost:8000
VITE_LIVE_FEATURES=projects,requirements,activity,settings,code-generation,testing,deployment
