{
  "$defs": {
    "RestoreStep": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "minLength": 1,
          "title": "Action",
          "type": "string"
        },
        "constraint": {
          "default": "",
          "title": "Constraint",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "movesTraffic": {
          "default": false,
          "title": "Movestraffic",
          "type": "boolean"
        },
        "provider": {
          "enum": [
            "github",
            "vercel",
            "render",
            "neon",
            "atlas",
            "local-docker"
          ],
          "title": "Provider",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "provider",
        "action",
        "movesTraffic",
        "constraint"
      ],
      "title": "RestoreStep",
      "type": "object"
    },
    "UpdateRollback": {
      "additionalProperties": false,
      "description": "Whether a rollback is prepared for one update, as FR17 and FR19 require.",
      "properties": {
        "level": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Level",
          "type": "string"
        },
        "reason": {
          "default": "",
          "title": "Reason",
          "type": "string"
        },
        "status": {
          "enum": [
            "prepared",
            "not-required",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        },
        "updateId": {
          "pattern": "^u-[0-9a-f]{12}$",
          "title": "Updateid",
          "type": "string"
        }
      },
      "required": [
        "updateId",
        "level",
        "status",
        "reason"
      ],
      "title": "UpdateRollback",
      "type": "object"
    },
    "VerificationCheck": {
      "additionalProperties": false,
      "properties": {
        "expect": {
          "minLength": 1,
          "title": "Expect",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "fingerprint",
            "health",
            "smoke"
          ],
          "title": "Kind",
          "type": "string"
        },
        "role": {
          "enum": [
            "frontend",
            "backend",
            "database",
            "app"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "role",
        "expect"
      ],
      "title": "VerificationCheck",
      "type": "object"
    },
    "VerifiedRelease": {
      "additionalProperties": false,
      "description": "A release that passed verification where it runs, which a restore can return to.",
      "properties": {
        "candidateHash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Candidatehash",
          "type": "string"
        },
        "commitSha": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Commitsha"
        },
        "deployVersion": {
          "minimum": 1,
          "title": "Deployversion",
          "type": "integer"
        },
        "deploymentId": {
          "minLength": 1,
          "title": "Deploymentid",
          "type": "string"
        },
        "imageDigest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Imagedigest"
        },
        "lockfileSha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lockfilesha256"
        },
        "renderDeployId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Renderdeployid"
        },
        "target": {
          "enum": [
            "local",
            "cloud"
          ],
          "title": "Target",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "vercelDeploymentId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verceldeploymentid"
        },
        "verifiedAt": {
          "title": "Verifiedat",
          "type": "string"
        }
      },
      "required": [
        "deploymentId",
        "deployVersion",
        "candidateHash",
        "lockfileSha256",
        "target",
        "imageDigest",
        "commitSha",
        "renderDeployId",
        "vercelDeploymentId",
        "url",
        "verifiedAt"
      ],
      "title": "VerifiedRelease",
      "type": "object"
    }
  },
  "$id": "https://sdlc.local/contracts/rollback-plan.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The `rollback-plan` artefact.",
  "properties": {
    "approval": {
      "const": "required",
      "default": "required",
      "title": "Approval",
      "type": "string"
    },
    "blocks": {
      "description": "High updates whose rollback is unavailable, which the release guards refuse.",
      "items": {
        "type": "string"
      },
      "readOnly": true,
      "title": "Blocks",
      "type": "array"
    },
    "candidateHash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Candidatehash",
      "type": "string"
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/VerificationCheck"
      },
      "title": "Checks",
      "type": "array"
    },
    "dataNote": {
      "default": "",
      "title": "Datanote",
      "type": "string"
    },
    "generatedAt": {
      "title": "Generatedat",
      "type": "string"
    },
    "providerConstraints": {
      "items": {
        "type": "string"
      },
      "title": "Providerconstraints",
      "type": "array"
    },
    "restorable": {
      "title": "Restorable",
      "type": "boolean"
    },
    "restoreTarget": {
      "anyOf": [
        {
          "$ref": "#/$defs/VerifiedRelease"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/RestoreStep"
      },
      "title": "Steps",
      "type": "array"
    },
    "strategy": {
      "const": "application-only",
      "default": "application-only",
      "title": "Strategy",
      "type": "string"
    },
    "unrestorableReason": {
      "default": "",
      "title": "Unrestorablereason",
      "type": "string"
    },
    "updates": {
      "items": {
        "$ref": "#/$defs/UpdateRollback"
      },
      "title": "Updates",
      "type": "array"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "version",
    "generatedAt",
    "candidateHash",
    "strategy",
    "approval",
    "restoreTarget",
    "restorable",
    "unrestorableReason",
    "steps",
    "checks",
    "updates",
    "providerConstraints",
    "dataNote",
    "blocks"
  ],
  "title": "RollbackPlan",
  "type": "object"
}
