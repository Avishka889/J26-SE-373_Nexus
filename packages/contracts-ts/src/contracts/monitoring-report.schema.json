{
  "$defs": {
    "DeploymentEvent": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "title": "At",
          "type": "string"
        },
        "deploymentId": {
          "minLength": 1,
          "title": "Deploymentid",
          "type": "string"
        },
        "detail": {
          "default": "",
          "title": "Detail",
          "type": "string"
        },
        "kind": {
          "enum": [
            "released",
            "verified",
            "degraded",
            "down",
            "recovered",
            "rollback-requested",
            "rollback-approved",
            "rolled-back",
            "rollback-failed"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "at",
        "kind",
        "deploymentId",
        "detail"
      ],
      "title": "DeploymentEvent",
      "type": "object"
    },
    "HealthThresholds": {
      "additionalProperties": false,
      "description": "The numbers the health rule compares against, recorded with its verdict.",
      "properties": {
        "coldStartFirstMs": {
          "default": 90000,
          "minimum": 1,
          "title": "Coldstartfirstms",
          "type": "integer"
        },
        "coldStartIdleSeconds": {
          "default": 900,
          "minimum": 1,
          "title": "Coldstartidleseconds",
          "type": "integer"
        },
        "degradedP95Ms": {
          "default": 2000,
          "minimum": 1,
          "title": "Degradedp95Ms",
          "type": "integer"
        },
        "minSamples": {
          "default": 3,
          "minimum": 1,
          "title": "Minsamples",
          "type": "integer"
        }
      },
      "required": [
        "degradedP95Ms",
        "coldStartIdleSeconds",
        "coldStartFirstMs",
        "minSamples"
      ],
      "title": "HealthThresholds",
      "type": "object"
    },
    "ProbeSummary": {
      "additionalProperties": false,
      "description": "One kind of probe across the window.",
      "properties": {
        "lastError": {
          "default": "",
          "title": "Lasterror",
          "type": "string"
        },
        "ok": {
          "minimum": 0,
          "title": "Ok",
          "type": "integer"
        },
        "p50Ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P50Ms"
        },
        "p95Ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P95Ms"
        },
        "probe": {
          "minLength": 1,
          "title": "Probe",
          "type": "string"
        },
        "samples": {
          "minimum": 0,
          "title": "Samples",
          "type": "integer"
        }
      },
      "required": [
        "probe",
        "samples",
        "ok",
        "p50Ms",
        "p95Ms",
        "lastError"
      ],
      "title": "ProbeSummary",
      "type": "object"
    },
    "StateInterval": {
      "additionalProperties": false,
      "description": "One stretch of the window in one state, and what put it there.",
      "properties": {
        "end": {
          "title": "End",
          "type": "string"
        },
        "evidence": {
          "minLength": 1,
          "title": "Evidence",
          "type": "string"
        },
        "samples": {
          "minimum": 0,
          "title": "Samples",
          "type": "integer"
        },
        "start": {
          "title": "Start",
          "type": "string"
        },
        "state": {
          "enum": [
            "healthy",
            "degraded",
            "down",
            "cold-start",
            "unknown"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "state",
        "start",
        "end",
        "samples",
        "evidence"
      ],
      "title": "StateInterval",
      "type": "object"
    }
  },
  "$id": "https://sdlc.local/contracts/monitoring-report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The `monitoring-report` artefact.",
  "properties": {
    "currentState": {
      "enum": [
        "healthy",
        "degraded",
        "down",
        "cold-start",
        "unknown"
      ],
      "title": "Currentstate",
      "type": "string"
    },
    "deploymentId": {
      "minLength": 1,
      "title": "Deploymentid",
      "type": "string"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/DeploymentEvent"
      },
      "title": "Events",
      "type": "array"
    },
    "expectedCandidateHash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Expectedcandidatehash",
      "type": "string"
    },
    "fingerprintMatches": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fingerprintmatches"
    },
    "generatedAt": {
      "title": "Generatedat",
      "type": "string"
    },
    "idleFrom": {
      "anyOf": [
        {
          "enum": [
            "last-sample",
            "released",
            "given"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Idlefrom"
    },
    "idleSeconds": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Idleseconds"
    },
    "probeIntervalSeconds": {
      "minimum": 1,
      "title": "Probeintervalseconds",
      "type": "integer"
    },
    "probes": {
      "items": {
        "$ref": "#/$defs/ProbeSummary"
      },
      "title": "Probes",
      "type": "array"
    },
    "ruleId": {
      "const": "health-rule/1",
      "default": "health-rule/1",
      "title": "Ruleid",
      "type": "string"
    },
    "source": {
      "minLength": 1,
      "title": "Source",
      "type": "string"
    },
    "states": {
      "items": {
        "$ref": "#/$defs/StateInterval"
      },
      "title": "States",
      "type": "array"
    },
    "target": {
      "enum": [
        "local",
        "cloud"
      ],
      "title": "Target",
      "type": "string"
    },
    "thresholds": {
      "$ref": "#/$defs/HealthThresholds"
    },
    "urls": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Urls",
      "type": "array"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    },
    "windowEnd": {
      "title": "Windowend",
      "type": "string"
    },
    "windowStart": {
      "title": "Windowstart",
      "type": "string"
    }
  },
  "required": [
    "version",
    "generatedAt",
    "deploymentId",
    "target",
    "urls",
    "source",
    "windowStart",
    "windowEnd",
    "probeIntervalSeconds",
    "ruleId",
    "thresholds",
    "probes",
    "states",
    "currentState",
    "expectedCandidateHash",
    "fingerprintMatches",
    "events",
    "idleSeconds",
    "idleFrom"
  ],
  "title": "MonitoringReport",
  "type": "object"
}
