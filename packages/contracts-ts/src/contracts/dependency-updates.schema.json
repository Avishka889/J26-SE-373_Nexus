{
  "$defs": {
    "BaselinePin": {
      "additionalProperties": false,
      "description": "The exact dependency set the analysis starts from.\n\nThe generated projects carry no lockfile and caret ranges throughout, so\nuntil this was recorded nothing said which versions the tested build had\ninstalled. A rollback that restores \"the previous release\" restores this.",
      "properties": {
        "direct": {
          "minimum": 0,
          "title": "Direct",
          "type": "integer"
        },
        "lockfilePath": {
          "minLength": 1,
          "title": "Lockfilepath",
          "type": "string"
        },
        "lockfileSha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Lockfilesha256",
          "type": "string"
        },
        "packages": {
          "minimum": 0,
          "title": "Packages",
          "type": "integer"
        },
        "resolvedBy": {
          "minLength": 1,
          "title": "Resolvedby",
          "type": "string"
        }
      },
      "required": [
        "lockfilePath",
        "lockfileSha256",
        "packages",
        "direct",
        "resolvedBy"
      ],
      "title": "BaselinePin",
      "type": "object"
    },
    "DependencyUpdate": {
      "additionalProperties": false,
      "description": "One update the registry offers, and everything retrieved about it.",
      "properties": {
        "alsoDeclaredIn": {
          "items": {
            "type": "string"
          },
          "title": "Alsodeclaredin",
          "type": "array"
        },
        "candidate": {
          "enum": [
            "in-range",
            "latest"
          ],
          "title": "Candidate",
          "type": "string"
        },
        "change": {
          "enum": [
            "major",
            "minor",
            "patch",
            "prerelease",
            "build-only",
            "beyond-patch",
            "qualifier",
            "downgrade",
            "non-semver",
            "unparseable"
          ],
          "title": "Change",
          "type": "string"
        },
        "declared": {
          "minLength": 1,
          "title": "Declared",
          "type": "string"
        },
        "ecosystem": {
          "enum": [
            "npm",
            "maven"
          ],
          "title": "Ecosystem",
          "type": "string"
        },
        "flags": {
          "items": {
            "enum": [
              "initial-development",
              "prerelease-target",
              "build-metadata",
              "qualifier"
            ],
            "type": "string"
          },
          "title": "Flags",
          "type": "array"
        },
        "fromVersion": {
          "minLength": 1,
          "title": "Fromversion",
          "type": "string"
        },
        "id": {
          "pattern": "^u-[0-9a-f]{12}$",
          "title": "Id",
          "type": "string"
        },
        "key": {
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "manifestLine": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Manifestline"
        },
        "manifestPath": {
          "minLength": 1,
          "title": "Manifestpath",
          "type": "string"
        },
        "notes": {
          "items": {
            "$ref": "#/$defs/ReleaseNoteRef"
          },
          "title": "Notes",
          "type": "array"
        },
        "notesUnavailable": {
          "default": "",
          "title": "Notesunavailable",
          "type": "string"
        },
        "package": {
          "minLength": 1,
          "title": "Package",
          "type": "string"
        },
        "publishedAt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Publishedat"
        },
        "repositoryUrl": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Repositoryurl"
        },
        "scope": {
          "enum": [
            "prod",
            "dev",
            "peer",
            "optional",
            "compile",
            "test",
            "runtime",
            "provided",
            "plugin",
            "import",
            "system"
          ],
          "title": "Scope",
          "type": "string"
        },
        "supersededBy": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supersededby"
        },
        "toVersion": {
          "minLength": 1,
          "title": "Toversion",
          "type": "string"
        },
        "transitive": {
          "items": {
            "$ref": "#/$defs/TransitiveShift"
          },
          "title": "Transitive",
          "type": "array"
        }
      },
      "required": [
        "id",
        "key",
        "ecosystem",
        "package",
        "manifestPath",
        "manifestLine",
        "alsoDeclaredIn",
        "scope",
        "declared",
        "fromVersion",
        "toVersion",
        "candidate",
        "supersededBy",
        "change",
        "flags",
        "publishedAt",
        "repositoryUrl",
        "notes",
        "notesUnavailable",
        "transitive"
      ],
      "title": "DependencyUpdate",
      "type": "object"
    },
    "RegistryQuery": {
      "additionalProperties": false,
      "description": "One question asked of a registry, and whether it answered.\n\nRecorded so that \"no newer version\" can be told apart from \"the registry\nwas not reachable\", which read the same in a list of updates.",
      "properties": {
        "at": {
          "title": "At",
          "type": "string"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        },
        "registry": {
          "minLength": 1,
          "title": "Registry",
          "type": "string"
        },
        "status": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status"
        },
        "url": {
          "minLength": 1,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "registry",
        "url",
        "at",
        "status",
        "note"
      ],
      "title": "RegistryQuery",
      "type": "object"
    },
    "RejectedUpdate": {
      "additionalProperties": false,
      "description": "An update that could not be analysed, and why (FR3).",
      "properties": {
        "declared": {
          "minLength": 1,
          "title": "Declared",
          "type": "string"
        },
        "detail": {
          "minLength": 1,
          "title": "Detail",
          "type": "string"
        },
        "ecosystem": {
          "enum": [
            "npm",
            "maven"
          ],
          "title": "Ecosystem",
          "type": "string"
        },
        "fromVersion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fromversion"
        },
        "manifestPath": {
          "minLength": 1,
          "title": "Manifestpath",
          "type": "string"
        },
        "package": {
          "minLength": 1,
          "title": "Package",
          "type": "string"
        },
        "reason": {
          "enum": [
            "package-not-found",
            "version-not-found",
            "not-a-registry-dependency",
            "registry-unreachable",
            "unresolvable-version",
            "not-an-upgrade",
            "unsupported-ecosystem"
          ],
          "title": "Reason",
          "type": "string"
        },
        "toVersion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Toversion"
        }
      },
      "required": [
        "package",
        "ecosystem",
        "manifestPath",
        "declared",
        "fromVersion",
        "toVersion",
        "reason",
        "detail"
      ],
      "title": "RejectedUpdate",
      "type": "object"
    },
    "ReleaseNoteRef": {
      "additionalProperties": false,
      "description": "One release note text, as read, with where the stored copy lives.",
      "properties": {
        "chars": {
          "minimum": 0,
          "title": "Chars",
          "type": "integer"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "source": {
          "enum": [
            "github-release",
            "changelog-file",
            "migration-guide"
          ],
          "title": "Source",
          "type": "string"
        },
        "truncated": {
          "default": false,
          "title": "Truncated",
          "type": "boolean"
        },
        "url": {
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "source",
        "url",
        "version",
        "path",
        "sha256",
        "chars",
        "truncated"
      ],
      "title": "ReleaseNoteRef",
      "type": "object"
    },
    "TransitiveShift": {
      "additionalProperties": false,
      "description": "A package the update moves without being asked to, seen in the lockfile.\n\n`added` and `removed` are a package appearing in or leaving the tree, which\nis not a move between two versions and is not given a SemVer name.",
      "properties": {
        "change": {
          "anyOf": [
            {
              "enum": [
                "major",
                "minor",
                "patch",
                "prerelease",
                "build-only",
                "beyond-patch",
                "qualifier",
                "downgrade",
                "non-semver",
                "unparseable"
              ],
              "type": "string"
            },
            {
              "enum": [
                "added",
                "removed"
              ],
              "type": "string"
            }
          ],
          "title": "Change"
        },
        "fromVersion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fromversion"
        },
        "package": {
          "minLength": 1,
          "title": "Package",
          "type": "string"
        },
        "toVersion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Toversion"
        }
      },
      "required": [
        "package",
        "fromVersion",
        "toVersion",
        "change"
      ],
      "title": "TransitiveShift",
      "type": "object"
    }
  },
  "$id": "https://sdlc.local/contracts/dependency-updates.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The `dependency-updates` artefact: one deploy version's view of the registries.",
  "properties": {
    "baseline": {
      "anyOf": [
        {
          "$ref": "#/$defs/BaselinePin"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "codeVersion": {
      "minimum": 1,
      "title": "Codeversion",
      "type": "integer"
    },
    "generatedAt": {
      "title": "Generatedat",
      "type": "string"
    },
    "queried": {
      "items": {
        "$ref": "#/$defs/RegistryQuery"
      },
      "title": "Queried",
      "type": "array"
    },
    "rejected": {
      "items": {
        "$ref": "#/$defs/RejectedUpdate"
      },
      "title": "Rejected",
      "type": "array"
    },
    "rejectedCount": {
      "readOnly": true,
      "title": "Rejectedcount",
      "type": "integer"
    },
    "target": {
      "minLength": 1,
      "title": "Target",
      "type": "string"
    },
    "testVersion": {
      "minimum": 1,
      "title": "Testversion",
      "type": "integer"
    },
    "upToDate": {
      "items": {
        "type": "string"
      },
      "title": "Uptodate",
      "type": "array"
    },
    "updates": {
      "items": {
        "$ref": "#/$defs/DependencyUpdate"
      },
      "title": "Updates",
      "type": "array"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "version",
    "generatedAt",
    "codeVersion",
    "testVersion",
    "target",
    "baseline",
    "updates",
    "rejected",
    "upToDate",
    "queried",
    "rejectedCount"
  ],
  "title": "DependencyUpdates",
  "type": "object"
}
