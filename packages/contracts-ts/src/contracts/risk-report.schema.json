{
  "$defs": {
    "Arbitration": {
      "additionalProperties": false,
      "description": "How the votes became one level (FR6, FR7).",
      "properties": {
        "advisory": {
          "default": "",
          "title": "Advisory",
          "type": "string"
        },
        "decidedBy": {
          "items": {
            "enum": [
              "semver",
              "changelog",
              "usage"
            ],
            "type": "string"
          },
          "title": "Decidedby",
          "type": "array"
        },
        "final": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Final",
          "type": "string"
        },
        "ruleId": {
          "const": "safety-first-max/1",
          "default": "safety-first-max/1",
          "title": "Ruleid",
          "type": "string"
        }
      },
      "required": [
        "ruleId",
        "final",
        "decidedBy",
        "advisory"
      ],
      "title": "Arbitration",
      "type": "object"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "description": "One piece of evidence a vote rests on, summarised for a reader.",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "version",
            "claim",
            "reference",
            "api-diff",
            "component"
          ],
          "title": "Kind",
          "type": "string"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "summary"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "Latency": {
      "additionalProperties": false,
      "description": "Seconds spent per step for one update (NFR1).\n\nThe assessment is the changelog step, the usage step and the arbitration.\nRetrieval is reported beside it rather than inside it, because NFR1 bounds\nthe assessment and a slow registry is not the engine being slow.",
      "properties": {
        "arbitrationSeconds": {
          "minimum": 0,
          "title": "Arbitrationseconds",
          "type": "number"
        },
        "assessmentSeconds": {
          "readOnly": true,
          "title": "Assessmentseconds",
          "type": "number"
        },
        "changelogSeconds": {
          "minimum": 0,
          "title": "Changelogseconds",
          "type": "number"
        },
        "retrievalSeconds": {
          "default": 0.0,
          "minimum": 0,
          "title": "Retrievalseconds",
          "type": "number"
        },
        "usageSeconds": {
          "minimum": 0,
          "title": "Usageseconds",
          "type": "number"
        }
      },
      "required": [
        "changelogSeconds",
        "usageSeconds",
        "arbitrationSeconds",
        "retrievalSeconds",
        "assessmentSeconds"
      ],
      "title": "Latency",
      "type": "object"
    },
    "ModelCall": {
      "additionalProperties": false,
      "description": "One call to the model, whatever came of it (NFR13).",
      "properties": {
        "completionTokens": {
          "default": 0,
          "minimum": 0,
          "title": "Completiontokens",
          "type": "integer"
        },
        "durationSeconds": {
          "default": 0.0,
          "minimum": 0,
          "title": "Durationseconds",
          "type": "number"
        },
        "error": {
          "default": "",
          "title": "Error",
          "type": "string"
        },
        "modelId": {
          "minLength": 1,
          "title": "Modelid",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "answered",
            "malformed",
            "cut-off",
            "rate-limited",
            "provider-error"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "promptId": {
          "minLength": 1,
          "title": "Promptid",
          "type": "string"
        },
        "promptSha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Promptsha256",
          "type": "string"
        },
        "promptTokens": {
          "default": 0,
          "minimum": 0,
          "title": "Prompttokens",
          "type": "integer"
        },
        "requests": {
          "default": 0,
          "minimum": 0,
          "title": "Requests",
          "type": "integer"
        },
        "settings": {
          "$ref": "#/$defs/ModelCallSettings"
        },
        "statedLevel": {
          "anyOf": [
            {
              "enum": [
                "low",
                "medium",
                "high"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Statedlevel"
        }
      },
      "required": [
        "modelId",
        "promptId",
        "promptSha256",
        "settings",
        "outcome",
        "requests",
        "promptTokens",
        "completionTokens",
        "durationSeconds",
        "error",
        "statedLevel"
      ],
      "title": "ModelCall",
      "type": "object"
    },
    "ModelCallSettings": {
      "additionalProperties": false,
      "description": "The settings the call was made with, recorded because they change answers.",
      "properties": {
        "maxTokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maxtokens"
        },
        "temperature": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature"
        },
        "thinking": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Thinking"
        }
      },
      "required": [
        "maxTokens",
        "thinking",
        "temperature"
      ],
      "title": "ModelCallSettings",
      "type": "object"
    },
    "RuleSet": {
      "additionalProperties": false,
      "description": "The rule ids this report was produced under, so a table can name them.",
      "properties": {
        "arbitration": {
          "const": "safety-first-max/1",
          "default": "safety-first-max/1",
          "title": "Arbitration",
          "type": "string"
        },
        "changelog": {
          "const": "changelog-rule/1",
          "default": "changelog-rule/1",
          "title": "Changelog",
          "type": "string"
        },
        "semver": {
          "const": "semver-rule/1",
          "default": "semver-rule/1",
          "title": "Semver",
          "type": "string"
        },
        "strategy": {
          "const": "risk-strategy/1",
          "default": "risk-strategy/1",
          "title": "Strategy",
          "type": "string"
        },
        "usage": {
          "const": "usage-rule/1",
          "default": "usage-rule/1",
          "title": "Usage",
          "type": "string"
        }
      },
      "required": [
        "semver",
        "changelog",
        "usage",
        "arbitration",
        "strategy"
      ],
      "title": "RuleSet",
      "type": "object"
    },
    "SignalVote": {
      "additionalProperties": false,
      "description": "One signal's answer for one update, or its reason for having none.",
      "properties": {
        "abstainedReason": {
          "default": "",
          "title": "Abstainedreason",
          "type": "string"
        },
        "evidenceIds": {
          "items": {
            "type": "string"
          },
          "title": "Evidenceids",
          "type": "array"
        },
        "level": {
          "anyOf": [
            {
              "enum": [
                "low",
                "medium",
                "high"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Level"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "ruleId": {
          "minLength": 1,
          "title": "Ruleid",
          "type": "string"
        },
        "signal": {
          "enum": [
            "semver",
            "changelog",
            "usage"
          ],
          "title": "Signal",
          "type": "string"
        }
      },
      "required": [
        "signal",
        "level",
        "abstainedReason",
        "ruleId",
        "rationale",
        "evidenceIds"
      ],
      "title": "SignalVote",
      "type": "object"
    },
    "Strategy": {
      "additionalProperties": false,
      "description": "How an update at this level may ship (FR17, FR18, FR19).",
      "properties": {
        "deploy": {
          "enum": [
            "automatic",
            "approval",
            "approval-with-rollback"
          ],
          "title": "Deploy",
          "type": "string"
        },
        "manualReviewRequired": {
          "title": "Manualreviewrequired",
          "type": "boolean"
        },
        "rollbackRequired": {
          "title": "Rollbackrequired",
          "type": "boolean"
        },
        "ruleId": {
          "const": "risk-strategy/1",
          "default": "risk-strategy/1",
          "title": "Ruleid",
          "type": "string"
        }
      },
      "required": [
        "ruleId",
        "deploy",
        "manualReviewRequired",
        "rollbackRequired"
      ],
      "title": "Strategy",
      "type": "object"
    },
    "UpdateAssessment": {
      "additionalProperties": false,
      "description": "One update, assessed.",
      "properties": {
        "affectedComponents": {
          "items": {
            "type": "string"
          },
          "title": "Affectedcomponents",
          "type": "array"
        },
        "affectedFiles": {
          "items": {
            "type": "string"
          },
          "title": "Affectedfiles",
          "type": "array"
        },
        "arbitration": {
          "$ref": "#/$defs/Arbitration"
        },
        "change": {
          "enum": [
            "major",
            "minor",
            "patch",
            "prerelease",
            "build-only",
            "beyond-patch",
            "qualifier",
            "downgrade",
            "non-semver",
            "unparseable"
          ],
          "title": "Change",
          "type": "string"
        },
        "disagreement": {
          "readOnly": true,
          "title": "Disagreement",
          "type": "boolean"
        },
        "ecosystem": {
          "enum": [
            "npm",
            "maven"
          ],
          "title": "Ecosystem",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence",
          "type": "array"
        },
        "evidenceComplete": {
          "description": "Every vote that was cast cites at least one piece of evidence.",
          "readOnly": true,
          "title": "Evidencecomplete",
          "type": "boolean"
        },
        "explanation": {
          "default": "",
          "title": "Explanation",
          "type": "string"
        },
        "explanationCall": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModelCall"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "explanationDashesReplaced": {
          "default": 0,
          "minimum": 0,
          "title": "Explanationdashesreplaced",
          "type": "integer"
        },
        "explanationRefusal": {
          "default": "",
          "title": "Explanationrefusal",
          "type": "string"
        },
        "explanationSource": {
          "default": "none",
          "enum": [
            "model",
            "rule",
            "none"
          ],
          "title": "Explanationsource",
          "type": "string"
        },
        "explanationUnavailable": {
          "default": "",
          "title": "Explanationunavailable",
          "type": "string"
        },
        "fromVersion": {
          "minLength": 1,
          "title": "Fromversion",
          "type": "string"
        },
        "key": {
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "latency": {
          "$ref": "#/$defs/Latency"
        },
        "package": {
          "minLength": 1,
          "title": "Package",
          "type": "string"
        },
        "strategy": {
          "$ref": "#/$defs/Strategy"
        },
        "toVersion": {
          "minLength": 1,
          "title": "Toversion",
          "type": "string"
        },
        "updateId": {
          "pattern": "^u-[0-9a-f]{12}$",
          "title": "Updateid",
          "type": "string"
        },
        "votes": {
          "items": {
            "$ref": "#/$defs/SignalVote"
          },
          "title": "Votes",
          "type": "array"
        }
      },
      "required": [
        "updateId",
        "key",
        "package",
        "ecosystem",
        "fromVersion",
        "toVersion",
        "change",
        "votes",
        "arbitration",
        "strategy",
        "affectedFiles",
        "affectedComponents",
        "evidence",
        "explanation",
        "explanationSource",
        "explanationRefusal",
        "explanationUnavailable",
        "explanationCall",
        "explanationDashesReplaced",
        "latency",
        "disagreement",
        "evidenceComplete"
      ],
      "title": "UpdateAssessment",
      "type": "object"
    }
  },
  "$id": "https://sdlc.local/contracts/risk-report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The `risk-report` artefact: every update at one deploy version, assessed.",
  "properties": {
    "assessments": {
      "items": {
        "$ref": "#/$defs/UpdateAssessment"
      },
      "title": "Assessments",
      "type": "array"
    },
    "byLevel": {
      "additionalProperties": {
        "type": "integer"
      },
      "readOnly": true,
      "title": "Bylevel",
      "type": "object"
    },
    "disagreements": {
      "readOnly": true,
      "title": "Disagreements",
      "type": "integer"
    },
    "evidenceIncomplete": {
      "readOnly": true,
      "title": "Evidenceincomplete",
      "type": "integer"
    },
    "explanationModelId": {
      "default": "",
      "title": "Explanationmodelid",
      "type": "string"
    },
    "explanationPromptId": {
      "default": "",
      "title": "Explanationpromptid",
      "type": "string"
    },
    "explanationPromptSha256": {
      "default": "",
      "title": "Explanationpromptsha256",
      "type": "string"
    },
    "explanationsRefused": {
      "description": "Model answers the check refused, each replaced by a rule written summary.",
      "readOnly": true,
      "title": "Explanationsrefused",
      "type": "integer"
    },
    "generatedAt": {
      "title": "Generatedat",
      "type": "string"
    },
    "latencyBudgetSeconds": {
      "default": 30.0,
      "exclusiveMinimum": 0,
      "title": "Latencybudgetseconds",
      "type": "number"
    },
    "overBudget": {
      "readOnly": true,
      "title": "Overbudget",
      "type": "integer"
    },
    "rules": {
      "$ref": "#/$defs/RuleSet"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "version",
    "generatedAt",
    "rules",
    "assessments",
    "latencyBudgetSeconds",
    "explanationModelId",
    "explanationPromptId",
    "explanationPromptSha256",
    "byLevel",
    "disagreements",
    "overBudget",
    "explanationsRefused",
    "evidenceIncomplete"
  ],
  "title": "RiskReport",
  "type": "object"
}
