.playwright-mcp

# Private research record. The exceptions are working documents the whole team
# follows rather than notes to myself: among them the backend implementation
# guide, the architecture document that says how the four components integrate,
# and the setup guide that takes a new laptop from a clone to a running platform.
docs/*
!docs/BACKEND_IMPLEMENTATION.md
!docs/High_Level_Architecture.md
!docs/Setup_Guide.md
!docs/Project_Gantt.md
!docs/repo-placement/
# The proposal's schedule figure and the script that generates it. The rest of
# this directory stays private: the ASCII flow walkthroughs and the exported
# images are working notes.
!docs/flow-diagrams/
docs/flow-diagrams/*
!docs/flow-diagrams/C3-Project-Schedule.drawio
!docs/flow-diagrams/make_gantt.py

# Secrets. Connection strings live here and must never be committed.
.env
.env.*
!.env.example
# Committed on purpose: it holds no secrets, and it is the record of how much
# of the product reads a real backend. One name per integration milestone.
!.env.development

# Node
node_modules/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
dist/
build/

# Browser console dumps pasted in while debugging a page. Useful in the moment,
# never part of the record.
console-logs.txt

# Trained model artefacts. The predictions and the run record are committed
# under studies/; the weights are half a gigabyte and live outside the repo.
services/c3-testing-security/model/
